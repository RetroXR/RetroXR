# type: ignore

Import('env', 'output_dir')

env = env.Clone()

# godot-cpp defaults debug_symbols to dev_build, so a plain target=template_debug
# links with none at all and a crash in this library resolves to nothing. Turn it
# on for every non-release target; an explicit debug_symbols=no still wins. Has to
# happen before godot-cpp's SConstruct, which is where the option is read.
from SCons.Script import ARGUMENTS
if ARGUMENTS.get("platform") == "macos":
    ARGUMENTS.setdefault("macos_deployment_target", "13.0")
if ARGUMENTS.get("target", "template_debug") != "template_release":
    ARGUMENTS.setdefault("debug_symbols", "yes")

# godot-cpp has no 4.6 or 4.7 branch: master carries every API from 4.3 on and
# binds the one it is told. Tools/build.py passes this too.
ARGUMENTS.setdefault("api_version", "4.7")
env = SConscript("../../libretro-godot/godot-cpp/SConstruct")


# godot-cpp hardcodes C++17 with no option to override it, and its own sources
# build from this same env, so appending a newer -std leaves both flags on every
# command line and MSVC warns D9025 once per translation unit. Drop it; the
# per-platform Append below sets ours.
env["CXXFLAGS"] = [f for f in env["CXXFLAGS"]
                   if not str(f).startswith(("/std:c++", "-std=c++"))]

env.Append(CPPPATH=[
    "external/pdfium/include/",
])

is_windows = env["platform"] == "windows"
is_android = env["platform"] == "android"
is_linux = env["platform"] == "linux"
is_macos = env["platform"] == "macos"

if is_windows:
    env.Append(CXXFLAGS=["/std:c++latest"])
    env.Append(LIBPATH=[r"external/pdfium/lib/win-x64"])
    env.Append(LIBS=["pdfium.dll.lib"])
    env.Append(LINKFLAGS=['/IGNORE:4099'])

if is_android:
    env.Append(CXXFLAGS=["-std=c++20"])
    env.Append(LIBPATH=["external/pdfium/lib/android-arm64"])
    env.Append(LIBS=["pdfium"])

if is_linux:
    env.Append(CXXFLAGS=["-std=c++20"])
    env.Append(LIBPATH=["external/pdfium/lib/linux-x64"])
    env.Append(LIBS=["pdfium"])
    # We ship our own libpdfium.so (it is not a system package). It lives in a
    # linux-x64/ subdir so the x86_64 .so never clobbers the android arm64
    # libpdfium.so that sits in the output dir root (they share a SONAME). The
    # $ORIGIN/linux-x64 rpath lets the loader resolve the NEEDED libpdfium.so
    # from that subdir at runtime. Quote exactly like godot-cpp's tools/linux.py
    # ($$ORIGIN unquoted collapses to empty under this SCons); godot-cpp already
    # adds a bare $ORIGIN entry — the loader skips the arch-mismatched arm64
    # libpdfium.so there and falls through to this x86_64 subdir.
    env.Append(LINKFLAGS=["-Wl,-R,'$$ORIGIN/linux-x64'"])

if is_macos:
    env.Append(CXXFLAGS=["-std=c++20"])
    mac_pdfium_platform = "mac-arm64" if env["arch"] == "arm64" else "mac-x64"
    # Root this path at the extension's SConstruct. A bare relative LIBPATH is
    # interpreted below VariantDir (Temp/) and makes ld warn that it does not
    # exist, even though the direct library dependency happens to resolve.
    env.Append(LIBPATH=["#external/pdfium/lib/{}".format(mac_pdfium_platform)])
    env.Append(LIBS=["pdfium"])

sources = Glob("src/*.cpp")

lib_prefix = "lib" if (is_android or is_linux) else ""
library = env.SharedLibrary("{}/{}godot-pdfium.{}.{}.{}{}".format(output_dir, lib_prefix, env["platform"], env["target"], env["arch"], env["SHLIBSUFFIX"]), source=sources)

# Copy runtime dependencies (shared libs) to output directory
if is_windows:
    pdfium_dll = env.InstallAs("{}/pdfium.dll".format(output_dir), "external/pdfium/lib/win-x64/pdfium.dll")
    env.Depends(library, pdfium_dll)

if is_android:
    pdfium_so = env.InstallAs("{}/libpdfium.so".format(output_dir), "external/pdfium/lib/android-arm64/libpdfium.so")
    env.Depends(library, pdfium_so)

if is_linux:
    pdfium_so = env.InstallAs("{}/linux-x64/libpdfium.so".format(output_dir), "external/pdfium/lib/linux-x64/libpdfium.so")
    env.Depends(library, pdfium_so)

if is_macos:
    # Upstream's dylib ID is "./libpdfium.dylib". Rewrite the extension's load
    # command to its packaged, architecture-specific sibling so arm64 and x64
    # runtime files can coexist in one Godot project.
    env.AddPostAction(
        library,
        "install_name_tool -change ./libpdfium.dylib "
        "@loader_path/{}/libpdfium.dylib \"$TARGET\"".format(mac_pdfium_platform))
    pdfium_dylib = env.InstallAs(
        "{}/{}/libpdfium.dylib".format(output_dir, mac_pdfium_platform),
        "external/pdfium/lib/{}/libpdfium.dylib".format(mac_pdfium_platform))
    env.Depends(library, pdfium_dylib)

Default(library)
