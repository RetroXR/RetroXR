# Arcade (MAME), retroXR build.
#
# Overrides the vendored libretro-core-info entry of the same name. It lives in its own
# directory because res://libretro-core-info is vendored wholesale from libretro's
# repository and is refreshed wholesale too -- an edit there would be lost the next time,
# silently. An overlay REPLACES the entry, so everything below is a whole copy of it with
# one addition: the BIOS and device ROM sets MAME looks for (the vendored entry declares
# none), so they show on the core's BIOS list and download from RomM by file name like
# any other firmware. Every one is optional: only the games on that hardware want it.
# MAME searches the ROM folder, SYSTEMDIR/mame/bios and SYSTEMDIR/mame/roms (see notes).
# Software Information
display_name = "Arcade (MAME)"
categories = "Emulator"
authors = "MAMEdev"
supported_extensions = "cmd|zip|7z"
corename = "MAME"
license = "GPLv2+"
permissions = ""
display_version = "Git"

# Hardware Information
manufacturer = "Various"
systemname = "Arcade (various)"
systemid = "arcade"

# Libretro Features
supports_no_game = "false"
database = "MAME"
savestate = "true"
savestate_features = "deterministic"
cheats = "false"
input_descriptors = "false"
memory_descriptors = "false"
libretro_saves = "false"
core_options = "true"
core_options_version = "1.0"
hw_render = "false"
disk_control = "false"

# Firmware
