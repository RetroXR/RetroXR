# SNK - Neo Geo Pocket / Color (Beetle NeoPop), retroXR build.
#
# Overrides the vendored libretro-core-info entry of the same name. It lives in
# its own directory because res://libretro-core-info is vendored wholesale from
# libretro's repository and is refreshed wholesale too — an edit there would be
# lost the next time, silently. An overlay REPLACES the entry, so everything
# below is a whole copy of it with only the names and version changed.
#
# The binary this describes is built from RetroXR/beetle-ngp-libretro at the tag
# retroxr-mednafen_ngp-libretro-v2 and published on that repository's releases page, which is
# also where its source is (GPLv2). What the fork adds is in CoreSources.

# Software Information
display_name = "SNK - Neo Geo Pocket / Color (Beetle NeoPop, retroXR)"
authors = "neopop_uk|Mednafen Team"
supported_extensions = "ngp|ngc|ngpc|npc"
corename = "Beetle NeoPop (retroXR)"
license = "GPLv2"
permissions = ""
display_version = "retroXR build"
categories = "Emulator"

# Hardware Information
manufacturer = "SNK"
systemname = "Neo Geo Pocket (Color)"
systemid = "ngp"

# Libretro Features
supports_no_game = "false"
database = "SNK - Neo Geo Pocket|SNK - Neo Geo Pocket Color"
savestate = "true"
savestate_features = "deterministic"

description = "An older fork of Mednafen's Neo Geo Pocket / Color core, which is itself a fork of the NeoPop emulator. While this core is quite fast, users who run into performance issues can try the performance-focused RACE core."
