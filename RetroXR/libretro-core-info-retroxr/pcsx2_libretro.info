# Sony - PlayStation 2 (LRPS2), retroXR build.
#
# Overrides the vendored libretro-core-info entry of the same name. It lives in
# its own directory because res://libretro-core-info is vendored wholesale from
# libretro's repository and is refreshed wholesale too — an edit there would be
# lost the next time, silently.
#
# The binary this describes is built from RetroXR/ps2 at the tag
# retroxr-pcsx2-libretro-v1 and published on that repository's releases page,
# which is also where its source is. LRPS2 is GPL-3.0, so the tag beside the
# binary is what meets the source obligation.

# Software Information
display_name = "Sony - PlayStation 2 (LRPS2, retroXR)"
authors = "PCSX2 Team"
supported_extensions = "elf|iso|ciso|cue|bin|gz|chd|cso|zso|mdf|nrg|dump|img|m3u"
corename = "LRPS2 (retroXR)"
license = "GPL"
permissions = ""
display_version = "retroXR build"
categories = "Emulator"

# Hardware Information
manufacturer = "Sony"
systemname = "Sony PlayStation 2"
systemid = "ps2"

# Libretro Features
database = "Sony - PlayStation 2"
supports_no_game = "false"
needs_fullpath = "true"
load_subsystem = "false"
hw_render = "true"
required_hw_api = "Vulkan >= 1.0 | Direct3D >= 12.0 | Direct3D >= 11.0 | OpenGL Core >= 3.3 | OpenGL >= 3.0"
savestate = "true"
savestate_features = "basic"
memory_descriptors = "false"

# Firmware / BIOS
firmware_count = 2
firmware0_desc = "'pcsx2/bios' folder"
firmware0_path = "pcsx2/bios"
firmware0_opt = "false"
firmware1_desc = "pcsx2/resources/GameIndex.yaml (Game Database)"
firmware1_path = "pcsx2/resources/GameIndex.yaml"
firmware1_opt = "true"
notes = "(!) Installs over the buildbot's LRPS2 under the same name, so saves, memory cards and core options carry across.|(!) The i.LINK port is this build's alone: a PS2 on the buildbot's core sits on an i.LINK cable joined to nothing.|[1] This only checks if the PCSX2 'bios' folder exists and is in the correct location.|[2] Because the core doesn't require any specific filename for the BIOS files,|[^] this info file cannot tell you if the content of your 'bios' folder is correct or not.|[3] Please check https://docs.libretro.com/library/lrps2/#bios for more details.|[4] The 'GameIndex.yaml' file can be downloaded from the Online Updater.|[^] But it is optional, since the core now bakes it in.|[5] The renderer option defaults to Auto, which asks the frontend which API|[^] it prefers; RetroXR answers Vulkan, so that is the context this core runs on here.|[6] Vulkan and Direct3D 12 are missing from the upstream required_hw_api line;|[^] the core builds and requests both."

description = "LRPS2, the libretro derivative of the mature and highly-compatible PCSX2 PlayStation 2 emulator, built from retroXR's fork. It is upstream LRPS2 plus the console's i.LINK (IEEE 1394) port on the frontend's link bus — protocol ps2-ilink-1394, core option pcsx2_ilink — which retroXR's i.LINK cable and six-port hub drive: Gran Turismo 3's i.LINK Battle for up to six consoles, its three-screen Broadcast set-up, and Time Crisis II's cooperative mode. The fork also carries a native AArch64 port, which is what the Android build runs on. Required BIOS files include EROM.BIN, rom1.bin, and at least one set of scph*.bin/.mec/.nvm dumps that match each region of games you wish to run. A newer BIOS than scph10000 is recommended, as this original BIOS has problems in memory card emulation and other sections. Source and binaries: github.com/RetroXR/ps2/releases/latest & the tag it points at."
