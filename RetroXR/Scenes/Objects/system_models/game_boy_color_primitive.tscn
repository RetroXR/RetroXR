; SELECT and START, each turned 25 degrees about Y so its right end is the higher
; one, on the same slant A and B sit on.
;
; A .tscn lists a basis by ROWS, so this is R_y(+25) written as its rows: the
; pill's long axis (local +X) comes out along (0.906, 0, -0.423), and -Z is up
; the face. Written from the columns it slants the other way.
[node name="SelectButton" type="MeshInstance3D" parent="." unique_id=1621150015]
transform = Transform3D(0.906308, 0, 0.422618, 0, 1, 0, -0.422618, 0, 0.906308, -0.0075, 0.0134, 0.039)
mesh = SubResource("BoxMesh_pill")
surface_material_override/0 = SubResource("StandardMaterial3D_pill")

[node name="StartButton" type="MeshInstance3D" parent="." unique_id=71394107]
transform = Transform3D(0.906308, 0, 0.422618, 0, 1, 0, -0.422618, 0, 0.906308, 0.0075, 0.0134, 0.039)
mesh = SubResource("BoxMesh_pill")
surface_material_override/0 = SubResource("StandardMaterial3D_pill")

