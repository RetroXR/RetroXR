[ext_resource type="ArrayMesh" path="res://Scenes/Objects/system_models/genesis/genesis_av_plug.res" id="3_avplugmesh"]
[ext_resource type="Script" path="res://Scripts/Objects/highlights/pickable_highlight.gd" id="4_pickhigh"]
[ext_resource type="PackedScene" uid="uid://dh8grd7s3n8kg" path="res://addons/godot-xr-tools/objects/grab_points/grab_point_snap.tscn" id="5_snapgp"]

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; The mini-DIN's moulded head, 11.5 mm round and 12 mm long, from gen_genesis_av.gd, as
; genesis_av_cable.tscn sizes its console end: the shield is inside a socket whenever
; the connector matters, and a shape over it would let the plug be grabbed through the
; back panel. A box, not a cylinder or sphere: those roll.
[sub_resource type="BoxShape3D" id="BoxShape3D_plugfit"]
size = Vector3(0.0115, 0.0115, 0.012)

; The laser target until the plug is in the room: PointerFit then makes it a box of
; what the plug draws.
[sub_resource type="SphereShape3D" id="SphereShape3D_avpointer"]
radius = 0.022

; Sega's Video Link Cable (600-6411), packed with every 32X: a short patch lead with
; the Genesis Model 2's round 9-pin mini-DIN at BOTH ends. One end goes in the
; console's A/V OUT, the other in the 32X's A/V IN, and the set is cabled to the 32X's
; A/V OUT with the console's own A/V Cable (ExpansionAv). Either end fits either
; socket, as on the real lead.
;
; ONE cord, CompositeCable's single-cord path: a mini-DIN carries the picture and both
; channels down one shell, and the link between two MultiAvPorts stands for all of
; them -- AvGraph carries what reaches the 32X's A/V IN on to its A/V OUT whole. The
; plugs are the console lead's own mesh, so a plug looks the same in the Genesis and
; in the 32X.
;
; Black, as Sega moulded it. cord_colors black too: the class tints a one-cord lead's
; plugs with it, and this plug has no tinted surface, so it changes nothing, but a
; yellow default would be a lie in the save.
[node name="Sega32xVideoLinkCable" type="Node3D"]
script = ExtResource("1_cablescript")
cord_colors = PackedColorArray(0.055, 0.055, 0.06, 1)
wire_color = Color(0.05, 0.05, 0.055, 1)

; -- End A --------------------------------------------------------------------
; Turned about Y so the cord trails toward the far end: the plug mesh is authored
; connector-on-+Z with the cord leaving -Z, which is also VerletRope's
; plug_exit_axis, so an unturned plug here would leave its tail with a hairpin.
[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.15)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.05
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_plugscript")
connector = "genesis_av_plug"

; On the BODY, behind the mating face that is the plug's origin (genesis_av_cable's
; note: a shape at the origin half buries itself in the socket).
[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.006)
shape = SubResource("BoxShape3D_plugfit")

[node name="PlugTip" type="MeshInstance3D" parent="PlugA0"]
mesh = ExtResource("3_avplugmesh")

[node name="PointerArea" type="StaticBody3D" parent="PlugA0"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0/PointerArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.006)
shape = SubResource("SphereShape3D_avpointer")

[node name="PickableHighlight" type="Node3D" parent="PlugA0"]
script = ExtResource("4_pickhigh")

[node name="SnapGrabPoint" parent="PlugA0" instance=ExtResource("5_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

; -- End B --------------------------------------------------------------------
; Unturned: its cord already trails -Z, back toward end A.
[node name="PlugB0" type="RigidBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.15)
collision_layer = 4
collision_mask = 196613
