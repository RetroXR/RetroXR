; 15 x 20 mm = 0.30 m. Sega's length is not on record; replacement patch leads for
; this hookup are sold at 30 cm (1 ft), and the A/V OUT on the console's back panel is
; ~10 cm from the 32X's A/V IN above it, so a shorter one would not hang. Shorter
; segments than the A/V lead's 30 mm keep a lead this short able to bend between the
; two sockets at all.
;
; One round cord, 5 mm, inside the plug boot's 6.8 mm end (CORD_R in gen_genesis_av.gd).
; collision_radius is the standoff from a contact plane and tracks the tube, as on
; trs_cable.tscn. No ribbon and no fray: CompositeCable's single-cord path anchors
; both ends straight to the two plugs.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 15
segment_length = 0.02
constraint_iterations = 8
bend_stiffness = 0.2
tube_radius = 0.0025
tube_sides = 8
smoothing = 2
rope_color = Color(0.05, 0.05, 0.055, 1.0)
surface_collision_mask = 7
collision_radius = 0.0038
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.45
end_stiff_segments = 2
