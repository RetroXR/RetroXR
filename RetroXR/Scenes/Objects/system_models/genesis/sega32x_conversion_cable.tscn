radius = 0.022

; Sega's Conversion Cable (600-6412): what goes between an ORIGINAL Genesis / Mega
; Drive (Model 1) and the 32X. The 32X takes the console's picture through its Video
; Link Cable, a 9-pin mini-DIN at both ends made for the Model 2; the Model 1's A/V OUT
; is the larger 8-pin DIN. So: this lead's DIN plug in the Model 1's A/V OUT, the Video
; Link Cable's plug in the mini-DIN socket at its other end (AvAdapter). It conducts and
; nothing else, so a lead from its socket is a lead from the console's own A/V OUT --
; the Video Link Cable on to the 32X, or the Model 2's own A/V Cable straight to a set.
;
; One cord, CompositeCable's single-rope path: both ends anchored straight to their
; bodies. End B fits nothing ("sega32x_conversion_body" is no socket's) -- it is the
; socket's body, and it hangs.
[node name="Sega32xConversionCable" type="Node3D"]
script = ExtResource("1_adapter")
cord_colors = PackedColorArray(0.05, 0.05, 0.055, 1)
wire_color = Color(0.05, 0.05, 0.055, 1.0)

; -- End A: the 8-pin DIN plug -------------------------------------------------
; Turned about Y so the cord trails toward the socket (connector on +Z, cord out of
; -Z, which is VerletRope's plug_exit_axis). The colliders sit on the BODY, behind the
; mating face, as on every console-end plug here.
[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.06)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.03
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_plugscript")
connector = "genesis1_av_plug"

