; The mini-DIN's moulded head, 7.2 mm round and 9 mm long, from gen_genesis_av.gd.
; Sized to the HEAD, not the whole plug: the shield is inside the console whenever
; the connector matters, and a shape over it would let the plug be grabbed through
; the back panel. A box, not a cylinder or sphere: those roll.
[sub_resource type="BoxShape3D" id="BoxShape3D_plugfit"]
size = Vector3(0.0072, 0.0072, 0.009)

[sub_resource type="SphereShape3D" id="SphereShape3D_avpointer"]
radius = 0.022

; The Genesis Model 2 A/V cable: a round 9-pin mini-DIN at the console, three phonos
; at the set, 1.80 m. The lead that shipped with the Model 2 and fits the Model 3; not
; the Model 1's, whose A/V OUT is an 8-pin DIN.
;
; Built as n64_av_cable.tscn is, and for its reasons: the console end is a SHARED end
; carrying all three cords (four plugs, three cords), what a cord carries is decided
; by the sockets its ends sit in, and which signal each cord is at the console end is
; MultiAvPort.channel_for's cord index — yellow picture, white left, red right. The
; plug script is the only real difference, and it is one string: genesis_av_plug,
; which only GenesisAvPort accepts.
;
; BLACK jacket, as Sega moulded it, where Nintendo's leads are grey. `script` FIRST,
; then the export: an exported property does not exist until the script is attached,
; so a wire_color written above it is silently dropped.
[node name="GenesisAvCable" type="Node3D"]
script = ExtResource("1_cablescript")
wire_color = Color(0.05, 0.05, 0.055, 1.0)

; ── End A: the 9-pin mini-DIN ─────────────────────────────────────
; Turned about Y so the cord trails toward the far end: the plug mesh is authored
; connector-on-+Z with the cord leaving -Z, which is also VerletRope's
; plug_exit_axis, so an unturned plug here would leave its tail with a hairpin.
; On the centreline, unlike the phono ends — there is nothing to spread it against.

[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.75)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.05
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("6_mdplugscript")

; The colliders sit on the BODY, not on the origin. This connector's origin is its
; MATING face — the frame a snap zone seats to — and the whole moulding lies BEHIND
; it, so a shape left at the origin ends up half buried in the console while the part
; a hand reaches for carries nothing. That is exactly what happened when the stand-in
; cylinder, which sat in FRONT of its origin, was swapped for the real mesh: the plug
; became ungrabbable the moment it was plugged in.
[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0045)
shape = SubResource("BoxShape3D_plugfit")

[node name="PlugTip" type="MeshInstance3D" parent="PlugA0"]
mesh = ExtResource("7_avplugmesh")

[node name="PointerArea" type="StaticBody3D" parent="PlugA0"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0/PointerArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0045)
shape = SubResource("SphereShape3D_avpointer")

[node name="PickableHighlight" type="Node3D" parent="PlugA0"]
script = ExtResource("4_pickhigh")

[node name="SnapGrabPoint" parent="PlugA0" instance=ExtResource("5_snapgp")]
