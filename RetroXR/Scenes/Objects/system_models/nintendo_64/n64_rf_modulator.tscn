; RF OUT: speaks for the machine the block is seated in (AdapterRcaPort). The zone
; is the jack's MOUTH, where a seated phono plug's origin belongs; the drawn jack
; then lands 0.8 mm inside the face (rca_port.tscn pushes it back 10 mm, the
; model's sleeve stands 9.2 out). R_x(180): the mouth faces PlugA0 -Z, away from
; the console, and the RF switch's plug arrives from there.
[node name="RfOut" parent="PlugA0" instance=ExtResource("5_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, -0.01, 0.0051, -0.054)
script = ExtResource("6_portscript")
direction = 0
rf_feed = true

; The cap, authored at the CH3 detent (slider value 0): VRSlider.set_knob_mesh
; anchors it where it is found at the current value. Not under Shell, so hiding
; the stand-in leaves it until adopt_channel_knob replaces it.
[node name="ChannelKnob" type="MeshInstance3D" parent="PlugA0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.0035, 0.0023, -0.0448)
mesh = SubResource("BoxMesh_knob")

; CH3 at value 0 (the -X end), CH4 at value 1, 3 mm along +X.
