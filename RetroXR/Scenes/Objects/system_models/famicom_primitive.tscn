[gd_scene load_steps=15 format=3]

[ext_resource type="Script" path="res://Scripts/Objects/system_models/famicom_model.gd" id="1_fc"]

; The HVC-001: 220 x 150 mm on the table, 60 mm to the top of the deck. Those are
; the figures Nintendo published for the machine; no dimensioned drawing was
; found, and everything below is laid out against them rather than measured off
; hardware.
;
; The shape is one fact and it settles most of the rest: a dark red base the full
; 220 mm across, with a cream deck only 114 mm wide standing on the middle of it.
; The two 53 mm strips of base left either side ARE the controller wells -- their
; floor is the base's own top face -- and 114 + 53 + 53 is the whole width, which
; is why the machine has almost no wall between a cartridge and a controller.
;
; The cartridge mouth is the full width of that deck for the same reason. A
; Famicom cartridge is 110 x 70 x 17 mm (MediaDimensions), so a mouth sized to it
; would leave 2 mm of deck either side and two extra boxes to draw it; the gap
; between the deck's front and rear blocks is the mouth instead, 20 mm front to
; back for a 17 mm cartridge.
;
; The pads are DETACHABLE here, against the hardware, where both are hardwired.
; That is a deliberate concession: it reuses the controller-port snap zones every
; other console has instead of inventing captive pads, and the ports are on the
; front face under each well, which is where the real cords come out.
[sub_resource type="BoxMesh" id="Mesh_base"]
size = Vector3(0.22, 0.03, 0.15)

[sub_resource type="BoxMesh" id="Mesh_deck_front"]
size = Vector3(0.114, 0.03, 0.075)

[sub_resource type="BoxMesh" id="Mesh_deck_rear"]
size = Vector3(0.114, 0.03, 0.055)

[sub_resource type="BoxMesh" id="Mesh_cart_floor"]
size = Vector3(0.114, 0.002, 0.02)

[sub_resource type="BoxMesh" id="Mesh_lip"]
size = Vector3(0.004, 0.008, 0.15)

[sub_resource type="BoxMesh" id="Mesh_expansion"]
size = Vector3(0.04, 0.01, 0.002)

; The rear panel, read off a photograph of the real machine: a black legend
; strip, then AC ADAPTER, TV/GAME, CH1/CH2 and the RF SWITCH socket across it,
; with a cord grommet at each corner.
[sub_resource type="BoxMesh" id="Mesh_legend"]
size = Vector3(0.15, 0.006, 0.0012)

[sub_resource type="BoxMesh" id="Mesh_dc_jack"]
size = Vector3(0.012, 0.012, 0.002)

[sub_resource type="BoxMesh" id="Mesh_slide"]
size = Vector3(0.011, 0.007, 0.002)

[sub_resource type="CylinderMesh" id="Mesh_grommet"]
top_radius = 0.005
bottom_radius = 0.005
height = 0.007

; Cream above, dark red below -- the two colours the machine is known by. Both
; are matte mouldings, so neither is shiny.
[sub_resource type="StandardMaterial3D" id="Mat_cream"]
albedo_color = Color(0.89, 0.86, 0.77, 1)
roughness = 0.65

[sub_resource type="StandardMaterial3D" id="Mat_red"]
albedo_color = Color(0.47, 0.09, 0.09, 1)
roughness = 0.6

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
albedo_color = Color(0.08, 0.08, 0.08, 1)
roughness = 0.9

[node name="FamicomModel" type="Node3D"]
script = ExtResource("1_fc")

[node name="Body" type="Node3D" parent="."]

[node name="Base" type="MeshInstance3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.015, 0)
mesh = SubResource("Mesh_base")
surface_material_override/0 = SubResource("Mat_red")

; z 0.000 .. 0.075, so the mouth opens behind it.
[node name="DeckFront" type="MeshInstance3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.045, 0.0375)
mesh = SubResource("Mesh_deck_front")
surface_material_override/0 = SubResource("Mat_cream")

; z -0.075 .. -0.020.
[node name="DeckRear" type="MeshInstance3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.045, -0.0475)
mesh = SubResource("Mesh_deck_rear")
surface_material_override/0 = SubResource("Mat_cream")

; The bottom of the slot, 1 mm above the deck's floor so the cartridge's own
; edge is what a player sees resting on it.
[node name="CartFloor" type="MeshInstance3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.031, -0.01)
mesh = SubResource("Mesh_cart_floor")
surface_material_override/0 = SubResource("Mat_dark")

; The outer edge of each well stands 8 mm proud, which is what keeps a pad in it.
[node name="WellLipLeft" type="MeshInstance3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.108, 0.034, 0)
mesh = SubResource("Mesh_lip")
surface_material_override/0 = SubResource("Mat_cream")

[node name="WellLipRight" type="MeshInstance3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.108, 0.034, 0)
mesh = SubResource("Mesh_lip")
surface_material_override/0 = SubResource("Mat_cream")

; The top of the deck, centred on the mouth. A cartridge goes in label-forward
; and stands up out of the machine.
[node name="CartSeat" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.06, -0.01)

[node name="Front" type="Node3D" parent="."]

; The 15-pin expansion connector, centred on the front face. Geometry only: no
; ExpansionCatalog unit names famicom as its host, so nothing can be seated in
; it -- the Disk System's row still says nes, and host is single-valued.
[node name="ExpansionRecess" type="MeshInstance3D" parent="Front"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.015, 0.0755)
mesh = SubResource("Mesh_expansion")
surface_material_override/0 = SubResource("Mat_dark")

; The machine's own printing, on the front wall of the deck between the wells.
; The wordmark beside it on the hardware is deliberately not drawn -- see the
; note in Textures/Controllers/ATTRIBUTIONS.txt about the NES pad.
[node name="NameLabel" type="Label3D" parent="Front"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0415, 0.0755)
pixel_size = 5e-05
modulate = Color(0.32, 0.3, 0.28, 1)
text = "FAMILY COMPUTER"
font_size = 48

[node name="Top" type="Node3D" parent="."]

; POWER and RESET sit side by side on the front of the deck's top face, POWER on
; the left. Read off photographs; the real POWER is a slide switch and RESET a
; round button, and both are drawn here with the cabinet's own button caps.
[node name="PowerSeat" type="Marker3D" parent="Top"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.028, 0.06, 0.055)

[node name="ResetSeat" type="Marker3D" parent="Top"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.028, 0.06, 0.055)

[node name="Rear" type="Node3D" parent="."]

; AC ADAPTER, TV/GAME, CH1/CH2, RF SWITCH -- the whole of the real panel, left to
; right as you look AT the back, which is the mirror of the x order here. There
; is no composite: the machine's one output is the RF socket, and a picture
; reaches a television through the RXR-003 switch box, as it did on the hardware.
[node name="Legend" type="MeshInstance3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0285, -0.0757)
mesh = SubResource("Mesh_legend")
surface_material_override/0 = SubResource("Mat_dark")

; Printed ON the strip, above the socket it names, which is where the real panel
; silk-screens its four labels. R_y(180) -- the same turn the socket seat takes --
; puts the text's +Z out of the back AND keeps its +Y up; R_x(180) would do the
; first and hang the words upside down and mirrored, because a viewer standing
; behind the machine has world -X on their right.
;
; This replaces the cabinet's derived plate, which printed VIDEO over AV OUT: a
; Famicom has no composite jack to call VIDEO and nothing on it is an AV OUT.
; famicom_model.configure_av_legend hides that one.
[node name="RfLabel" type="Label3D" parent="Rear"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -0.04, 0.0285, -0.0763)
pixel_size = 5e-05
modulate = Color(0.9, 0.9, 0.87, 1)
text = "RF OUT"
font_size = 40
outline_size = 0
alpha_cut = 1

[node name="AcJack" type="MeshInstance3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.045, 0.019, -0.0755)
mesh = SubResource("Mesh_dc_jack")
surface_material_override/0 = SubResource("Mat_dark")

[node name="TvGameSwitch" type="MeshInstance3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.012, 0.019, -0.0755)
mesh = SubResource("Mesh_slide")
surface_material_override/0 = SubResource("Mat_dark")

[node name="ChannelSwitch" type="MeshInstance3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.016, 0.019, -0.0755)
mesh = SubResource("Mesh_slide")
surface_material_override/0 = SubResource("Mat_dark")

; R_y(180), so the socket receives along the model's -Z -- out of the back, which
; is where a plug arrives from. Pushed 10 mm proud of the panel because that is
; where a seated phono plug's ORIGIN belongs; rca_port.tscn pulls its own jack
; back by the same 10 mm to land the flange on the case.
[node name="RfSeat" type="Marker3D" parent="Rear"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -0.04, 0.02, -0.085)

; The two cord grommets, one at each rear corner. A CylinderMesh stands on +Y,
; so R_x(-90) lays it along -Z and out through the panel.
[node name="GrommetLeft" type="MeshInstance3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, -4.371139e-08, 1, 0, -1, -4.371139e-08, -0.1, 0.018, -0.0765)
mesh = SubResource("Mesh_grommet")
surface_material_override/0 = SubResource("Mat_dark")

[node name="GrommetRight" type="MeshInstance3D" parent="Rear"]
transform = Transform3D(1, 0, 0, 0, -4.371139e-08, 1, 0, -1, -4.371139e-08, 0.1, 0.018, -0.0765)
mesh = SubResource("Mesh_grommet")
surface_material_override/0 = SubResource("Mat_dark")

; Where each hardwired cord meets the machine. The pads are moulded onto these,
; so the zones here are locked the moment RetroSystem seats them -- they exist to
; place a cord's end, not to be plugged into.
[node name="PortSeat1" type="Marker3D" parent="Rear"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -0.1, 0.018, -0.082)

[node name="PortSeat2" type="Marker3D" parent="Rear"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0.1, 0.018, -0.082)
