; The owner's Mission six-drawer chest (RetroXR-models generic/mission-bedroom; sizes estimated). Origin on the floor, the
; drawers towards +Z. DrawerFurniture builds the case's collision and every drawer (a sliding body, the node that
; draws it, a VRDrawer across its pulls) from the contract, so this scene carries none of its own.
[node name="MissionChest" type="RigidBody3D"]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_msn")
mass = 45.0
linear_damp = 6.0
angular_damp = 9.0
freeze_mode = 1
