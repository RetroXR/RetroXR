[sub_resource type="PhysicsMaterial" id="PhysMat_ctrl"]
friction = 0.8

; The BASE only, 76 x 35 x 79 mm. The stick stands 47 mm proud of it and is
; deliberately outside the body: a collider that swallowed it would stop the
; shaft ever being reachable, and it is the part you grab.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.0760, 0.0346, 0.0792)

[node name="Atari2600CX40" type="RigidBody3D" groups=["hand_held_device"]]
collision_layer = 4
collision_mask = 196613
mass = 0.2
physics_material_override = SubResource("PhysMat_ctrl")
freeze_mode = 1
linear_damp = 5.0
angular_damp = 8.0
script = ExtResource("1_joyscript")
plug_mesh_path = "res://Scenes/Objects/controllers/atari/atari_2600_plug_cx40.res"
systemid = "atari2600"
cable_length = 1.2192

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_body")

; The .glb rests ON its origin (y 0..0.0809), so drop it half the BASE height to
; sit the case's middle on the centre of mass. Not half the total: that would
; count the stick and hang the base below where it is held.
[node name="Model" parent="." instance=ExtResource("5_joymodel")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.01732, 0)

; The cord leaves the same edge the fire button sits on (-Z), which is the far
; side from the holder's wrist when the stick is held upright.
[node name="CableAttachPoint" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0396)

