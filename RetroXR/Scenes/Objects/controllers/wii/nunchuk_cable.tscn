[gd_scene format=3]

; The Nunchuk's cord. Same construction as controller_cable.tscn — see the notes
; there for why the rope is tuned the way it is — with two differences that make
; it this cord and not a console lead:
;
;   * 30 x 36 mm = 1.08 m, the real Nunchuk's length. A controller lead is 1.80 m
;     because it has to cross a living room; this one only has to reach the other
;     hand, and a full-length rope on it hangs in loops on the floor.
;   * A flat rectangular connector instead of the generic cylinder plug: the
;     Wiimote's expansion socket is a slot, not a round hole.

[ext_resource type="Script" path="res://Scripts/Objects/cables/controller_plug.gd" id="1_plugscript"]
[ext_resource type="Script" uid="uid://myg1jnlsxhnm" path="res://Scripts/Objects/highlights/pickable_highlight.gd" id="3_pickhigh"]
[ext_resource type="PackedScene" uid="uid://dh8grd7s3n8kg" path="res://addons/godot-xr-tools/objects/grab_points/grab_point_snap.tscn" id="4_snapgp"]

; Fitted to the connector mesh (measured by Tools/rope/plug_shape_probe), so a
; loose plug lies ON a surface at its real size. It was a sphere two to five
; times the plug's thickness, which rolled under any push and held the plug
; centimetres off the floor with nothing visibly holding it there.
[sub_resource type="BoxShape3D" id="BoxShape3D_plugfit"]
size = Vector3(0.013, 0.007, 0.03)

[sub_resource type="BoxMesh" id="BoxMesh_plug"]
size = Vector3(0.013, 0.005, 0.016)

[sub_resource type="StandardMaterial3D" id="Mat_plug"]
albedo_color = Color(0.88, 0.88, 0.89, 1)

[sub_resource type="BoxMesh" id="BoxMesh_strain"]
size = Vector3(0.009, 0.007, 0.014)

[sub_resource type="StandardMaterial3D" id="Mat_strain"]
albedo_color = Color(0.82, 0.82, 0.83, 1)

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; Same reasoning as the controller lead's: wider than the physics shape because a
; plug is a small thing to hit with a beam, and this only answers the pointer.
[sub_resource type="SphereShape3D" id="SphereShape3D_pointer"]
radius = 0.045

[node name="NunchukCable" type="Node3D"]

[node name="ControllerPlug" type="RigidBody3D" parent="."]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.03
linear_damp = 5.0
angular_damp = 8.0
gravity_scale = 1.0
freeze = false
freeze_mode = 1
script = ExtResource("1_plugscript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="ControllerPlug"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.003)
shape = SubResource("BoxShape3D_plugfit")

[node name="PlugTip" type="MeshInstance3D" parent="ControllerPlug"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.004)
mesh = SubResource("BoxMesh_plug")
surface_material_override/0 = SubResource("Mat_plug")

[node name="StrainRelief" type="MeshInstance3D" parent="ControllerPlug"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.011)
mesh = SubResource("BoxMesh_strain")
surface_material_override/0 = SubResource("Mat_strain")

[node name="PointerArea" type="StaticBody3D" parent="ControllerPlug"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="ControllerPlug/PointerArea"]
shape = SubResource("SphereShape3D_pointer")

[node name="PickableHighlight" type="Node3D" parent="ControllerPlug"]
script = ExtResource("3_pickhigh")

[node name="SnapGrabPoint" parent="ControllerPlug" instance=ExtResource("4_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 30
segment_length = 0.036
constraint_iterations = 8
bend_stiffness = 0.15
tube_radius = 0.00225
tube_sides = 8
smoothing = 2
rope_color = Color(0.88, 0.88, 0.89, 1.0)
surface_collision_mask = 7
collision_radius = 0.0036
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.3
end_stiff_segments = 2
