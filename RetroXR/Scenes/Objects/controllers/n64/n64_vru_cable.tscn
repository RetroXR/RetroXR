[gd_scene load_steps=19 format=3]

; The NUS-021 microphone and the cord that ends in its 3.5 mm plug. The
; microphone's long axis is Z, the grille head at -Z and the cord leaving the tail
; at +Z; every cylinder on the microphone is rotated so its local +Y is +Z, which
; makes top_radius the TAIL end and bottom_radius the head end. The plug is built
; the other way up, the way every plug in this project is: connector on +Z, cord
; trailing -Z.
;
; NOTHING HERE MAY SHARE A PLANE WITH ITS NEIGHBOUR. Two faces at one depth facing
; the same way trade pixels, and on a microphone's nose that is a black disc and a
; white disc doing it across 22 mm -- which is what this scene used to do, a flat
; grille collar ending on exactly the body's front cap at z -0.0475. Every part
; below is sunk into the next by millimetres, and n64_vru_tests "faces/" fails if
; that ever stops being true.
;
; Sizes are estimated from photographs -- no dimensioned drawing was found.

[ext_resource type="Script" path="res://Scripts/Objects/peripherals/n64_vru_mic.gd" id="1_mic"]
[ext_resource type="Script" uid="uid://myg1jnlsxhnm" path="res://Scripts/Objects/highlights/pickable_highlight.gd" id="2_pickhigh"]
[ext_resource type="Material" path="res://Scenes/Objects/controllers/n64/n64_pak_plastic.tres" id="3_plastic"]
[ext_resource type="Script" path="res://Scripts/Objects/peripherals/n64_vru_mic_plug.gd" id="4_micplug"]
[ext_resource type="PackedScene" uid="uid://dh8grd7s3n8kg" path="res://addons/godot-xr-tools/objects/grab_points/grab_point_snap.tscn" id="5_snapgp"]

; The ball of mesh at the speaking end. A sphere has no flat face at all, so the
; body can be driven straight into it with nothing to fight over.
[sub_resource type="SphereMesh" id="SphereMesh_head"]
radius = 0.013
height = 0.026
radial_segments = 24
rings = 12

; Metal mesh, not the matte black plastic this wore before: a grille is woven wire
; and catches a highlight the shell does not.
[sub_resource type="StandardMaterial3D" id="Mat_grille"]
albedo_color = Color(0.16, 0.16, 0.17, 1)
metallic = 0.35
roughness = 0.5

[sub_resource type="CylinderMesh" id="CylinderMesh_collar"]
top_radius = 0.0105
bottom_radius = 0.0115
height = 0.008
radial_segments = 24
rings = 1

; The handle, tapering to the tail the way a hand-held microphone does.
[sub_resource type="CylinderMesh" id="CylinderMesh_body"]
top_radius = 0.0085
bottom_radius = 0.01
height = 0.082
radial_segments = 24
rings = 1

[sub_resource type="SphereMesh" id="SphereMesh_tail"]
radius = 0.0085
height = 0.017
radial_segments = 20
rings = 10

