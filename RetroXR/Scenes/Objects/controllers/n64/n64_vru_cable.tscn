roughness = 0.9

[sub_resource type="CylinderShape3D" id="CylinderShape3D_mic"]
height = 0.082
radius = 0.0105

; The head carries its own shape, or the microphone lies on a floor with its ball
; 2.5 mm inside it.
[sub_resource type="SphereShape3D" id="SphereShape3D_head"]
radius = 0.013

[sub_resource type="PhysicsMaterial" id="PhysMat_mic"]
