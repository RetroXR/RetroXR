[sub_resource type="PhysicsMaterial" id="PhysMat_jp"]
friction = 0.8

; 47 x 55 x 22 mm and 60 g. The pack shares the VMU's 47 mm width because it
; goes into the same socket, is SHORTER because it carries no screen and no
; controls, and is half again as thick because it carries a motor and an
; off-centre weight. Those two differences are the whole of its silhouette, and
; are what make it recognisable beside a card in the other slot.
;
; Axes match the card's, and have to: the slot's seat transform is authored for
; that convention and is shared. +Y is the length, with the connector on that
; end, and +Z is the face that a player holding it sees.
;
; And so does the ORIGIN, which is the part that is easy to get wrong. A seat
; places an object's origin, and a VMU's origin is 40 mm below the end its
; connector is on. The pack is 55 long, so with its origin at its own centre
; that end was only 27.5 mm away -- and seated in a slot authored for the card,
; it floated 12.5 mm short: above the dongle's lid with its connector in the
; open, and behind the pad's rear face. Every mesh and shape below is lifted
; +12.5 mm so the body spans -15..+40 and the connector sits at +42.5, exactly
; where the card's does. The origin is no longer the middle of the pack; it is
; the card's reference point, which is the thing a shared seat needs.
[sub_resource type="BoxShape3D" id="Box_jp_body"]
size = Vector3(0.047, 0.055, 0.022)

[sub_resource type="BoxMesh" id="Mesh_jp_body"]
size = Vector3(0.047, 0.055, 0.022)

[sub_resource type="StandardMaterial3D" id="Mat_jp_shell"]
albedo_color = Color(0.898039, 0.890196, 0.870588, 1)
roughness = 0.55

; The same connector the card has, to the millimetre, because it is the same
; socket. Its own y puts it proud of the body's +Y end exactly as the card's is.
[sub_resource type="BoxMesh" id="Mesh_jp_connector"]
size = Vector3(0.0305, 0.007, 0.011)

[sub_resource type="StandardMaterial3D" id="Mat_jp_connector"]
albedo_color = Color(0.16, 0.16, 0.18, 1)
roughness = 0.6

; A shallow moulded recess across the face, which is what the real pack has
; where a VMU has its screen. It is also the quickest way to tell the two apart
; in a hand at arm's length.
[sub_resource type="BoxMesh" id="Mesh_jp_recess"]
size = Vector3(0.034, 0.02, 0.0016)

[sub_resource type="StandardMaterial3D" id="Mat_jp_recess"]
albedo_color = Color(0.317647, 0.32549, 0.333333, 1)
roughness = 0.45

[sub_resource type="BoxShape3D" id="Box_jp_pointer"]
size = Vector3(0.057, 0.065, 0.034)

