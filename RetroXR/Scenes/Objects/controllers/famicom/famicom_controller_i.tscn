; SELECT and START, the two small rectangles Controller II does not have. The
; labels lie flat on a face-up pad: R_x(-90) puts each one's +Z out of the face
; and its +Y away from the holder, so the words read upright from where a player
; stands rather than upside down or mirrored.
[node name="Select" type="MeshInstance3D" parent="Model/Face"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.011, 0.014, 0.014)
mesh = SubResource("BoxMesh_small")
surface_material_override/0 = SubResource("Mat_button")

