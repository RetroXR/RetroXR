; The microphone and its volume slider, moulded where Controller I has START and
; SELECT. The grille is geometry only -- what the console reads is one bit of
; this pad rather than a capture device -- and the slider decides how loud the
; room has to be before that bit is set, switching the microphone off at its far
; left the way the real one does.
[node name="MicGrille" type="MeshInstance3D" parent="Model/Face"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.014, 0.0133, 0.013)
mesh = SubResource("CylinderMesh_grille")
surface_material_override/0 = SubResource("Mat_grille")

[node name="Holes" type="MeshInstance3D" parent="Model/Face/MicGrille"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.0002, 0)
mesh = SubResource("CylinderMesh_grille_inner")
surface_material_override/0 = SubResource("Mat_grille_holes")

