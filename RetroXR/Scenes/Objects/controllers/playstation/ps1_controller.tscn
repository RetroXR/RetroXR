[ext_resource type="PackedScene" path="res://imported-assets/controllers/playstation/ps1_pad.glb" id="5_ps1model"]

[sub_resource type="PhysicsMaterial" id="PhysMat_ctrl"]
friction = 0.8

; The whole pad, grips included: 145 x 45 x 92 mm, measured off the asset.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.1449, 0.0446, 0.0916)

[node name="Ps1Controller" type="RigidBody3D" groups=["hand_held_device"]]
collision_layer = 4
collision_mask = 196613
mass = 0.2
physics_material_override = SubResource("PhysMat_ctrl")
freeze_mode = 1
linear_damp = 5.0
angular_damp = 8.0
script = ExtResource("1_ps1script")
plug_mesh_path = "res://Scenes/Objects/controllers/playstation/ps1_plug.res"
systemid = "psx"
cable_length = 2.0

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_body")

; The .glb rests ON its origin (y 0..0.0446), so drop it half the body height to
; sit the pad's middle on the centre of mass.
[node name="Model" parent="." instance=ExtResource("5_ps1model")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.0223, 0)

; The cord leaves the far edge (-Z), the side away from the holder's wrists --
; ON the shell, which -0.0458 was not. That was the collision box's rear plane
; (half of its 0.0916 depth), and the box is sized off the pad's whole AABB, which
; the SHOULDER BUTTONS set: they protrude to z -45.79 where the shell itself
; reaches only -43.85. Worse on the centre line, where the back edge is scalloped
; inward between the two shoulder clusters -- so the cord was starting 17.5 mm
; behind the controller, in open air.
;
; Raycast along +Z at x = 0 puts the rear surface at z -28.27 mm, rearmost over a
; plateau at y +3 to +9. Vertex sampling cannot find this: the centre bridge is a
; flat quad whose only vertices are its corners at x = +/-16.5, so measuring by
; vertices reports a 33 mm hole through the middle of the pad.
[node name="CableAttachPoint" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.004, -0.0283)

[node name="PickableHighlight" type="Node3D" parent="."]
script = ExtResource("2_pickhigh")

