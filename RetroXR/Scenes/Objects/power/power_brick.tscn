; ── PowerBrick: an AC adapter, built from its PowerBrickCatalog row ─────────────
;
; One scene for every adapter: power_brick.gd sizes the body from the row (the
; RetroXR-models item's own size_mm), keeps the parts its form has and frees the rest.
; A wall wart is all WallPlug (the prongs on its body); an in-line brick is Body with
; both cords fixed; an inlet brick is Body with a C8 inlet; the N64's is all DcPlug
; (it docks); a battery pack is Body and a DC cord. The root never moves, as the
; strip's: the player carries the Body (or the plug that is the body).
[node name="PowerBrick" type="Node3D"]
script = ExtResource("1_brick")

[node name="Body" type="RigidBody3D" parent="."]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("Phys_body")
mass = 0.35
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_body")

