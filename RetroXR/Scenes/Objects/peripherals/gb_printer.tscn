; PLACEHOLDER GEOMETRY, generated, so it carries no licence: the Game Boy
; Printer (MGB-007) as boxes, at the real unit's 135 x 70 x 60 mm (Science
; Museum object co8184142). Long axis on Z, the front (+Z) where the controls
; and the paper are, the EXT.IN socket on the back. No Nintendo marks.
;
; Along the top, front to back: POWER and FEED, the serrated tear edge, the
; paper slot, and the cover over the roll. Where those sit is from descriptions
; of the unit, not measured off one.

[sub_resource type="BoxMesh" id="BoxMesh_body"]
size = Vector3(0.07, 0.06, 0.135)

[sub_resource type="StandardMaterial3D" id="Mat_body"]
albedo_color = Color(0.74, 0.74, 0.72, 1)
roughness = 0.6

[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.07, 0.06, 0.135)

[sub_resource type="PhysicsMaterial" id="PhysMat_body"]
bounce = 0.0
friction = 0.9

[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.08, 0.07, 0.145)

; The cover over the paper roll: a raised darker panel on the rear two thirds.
