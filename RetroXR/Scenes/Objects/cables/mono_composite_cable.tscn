; Fitted to the connector mesh (measured by Tools/rope/plug_shape_probe), so a
; loose plug lies ON a surface at its real size. It was a sphere two to five
; times the plug's thickness, which rolled under any push and held the plug
; centimetres off the floor with nothing visibly holding it there.
[sub_resource type="BoxShape3D" id="BoxShape3D_plugfit"]
size = Vector3(0.0144, 0.0144, 0.054)

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; Laser target, deliberately wider than the physics box — a plug is a small
; thing to hit with a beam from across the room, and this shape only answers the
; pointer (mask 0). Tighter than cable.tscn's 55 mm: six plugs sit close enough
; together here that overlapping targets would make picking one of them a lottery.
[sub_resource type="SphereShape3D" id="SphereShape3D_pointer"]
radius = 0.032

; The lead a console with mono sound ships with: video and ONE audio channel, so
; two cords rather than three. Yellow and red, the pair an NES came with — and
; because a cord is only a wire, the red one plays out of whichever single speaker
; its far end is plugged into, exactly as the real thing does.
[node name="MonoCompositeCable" type="Node3D"]
script = ExtResource("1_cablescript")
cord_colors = PackedColorArray(0.95, 0.74, 0.02, 1, 0.72, 0.08, 0.08, 1)

; ── End A ────────────────────────────────────────────────────────────────────
; Turned about Y so the cord trails toward the far end: the plug mesh is authored
; connector-on-+Z with the cord leaving -Z, which is also VerletRope's
; plug_exit_axis, so an unturned plug here would leave its tail with a hairpin.
; Spread across X by half a cord pitch each side: two cords, not three.

