[sub_resource type="BoxMesh" id="BoxMesh_plug_ghost"]
size = Vector3(0.02,0.009,0.02)

[sub_resource type="StandardMaterial3D" id="Mat_plug_ghost"]
transparency = 1
albedo_color = Color(0.2, 0.5, 1, 0.45)
emission_enabled = true
emission = Color(0, 0.15, 0.5, 1)
emission_energy_multiplier = 0.4

; RetroXR-models generic/dterminal-socket: the ZONE is where a seated plug's origin stops (the
; socket's mouth; for the VHF terminals, the point between the two screw seats, 1 mm in
; front of the plate's face, so the model stands 1 mm behind it). A host stands the zone as
; far off its panel as TvInputKinds says. `connector` is written here as well as in the script.
[node name="DTerminalPort" instance=ExtResource("1_snapzone")]
grab_distance = 0.05
script = ExtResource("2_portscript")
connector = "dterminal_plug"

[node name="DterminalSocket" parent="." instance=ExtResource("3_socket")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)

[node name="SnapHighlight" type="Node3D" parent="."]
script = ExtResource("4_snaphigh")

[node name="HighlightMesh" type="MeshInstance3D" parent="SnapHighlight"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.01)
mesh = SubResource("BoxMesh_plug_ghost")
surface_material_override/0 = SubResource("Mat_plug_ghost")
