; -- The junction ---------------------------------------------------------------
; top_level because it RIDES the cord rather than hanging off the cable's origin:
; LinkCable places it on a rope particle every physics frame, and a socket that
; did not move with the lead it is moulded into would read as broken.
;
; Its own socket is a full LinkPort, not a decoration. A junction that looked
; like a socket and refused a plug would be worse than none at all, and the whole
; point of it is that the third and fourth players are real.
[node name="Junction" type="Node3D" parent="."]
top_level = true

[node name="Box" type="MeshInstance3D" parent="Junction"]
mesh = SubResource("BoxMesh_junction")
surface_material_override/0 = SubResource("Mat_junction")

; On the block's flank, MOUTH OUTWARD. The junction is oriented with -Z along the
; cord, so a socket left facing forward would point back down the wire it is
; moulded into; +X puts it on the side where a plug can reach it.
;
; The facing is the part that was wrong, and it is worth being explicit about
; because it is not visible in the number. A port's +Z points OUT of the thing it
; is a socket on, which is where the seated shell ends up; the nose travels the
; other way, into the shell. Every machine's port is authored that way. This one
; was turned round, which put the 20 mm shell inside a 17 mm block and left the
; 7 mm nose waving in the air. The block is small enough that this reads as the
; plug having been swallowed rather than as anything being the wrong way about.
[node name="LinkPort" parent="Junction" instance=ExtResource("5_linkport")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 0.0085, 0, 0)
connector = "agb_link_plug"

; 40 x 30 mm = 1.20 m, the length a GBA link cable ships at, against 0.96 m
; between the plugs so it hangs rather than pulling straight.
;
; The TRS lead's tuning: this is a thin cord, not an 8.3 mm shielded A/V jacket,
; so it wants the softer bend and the tighter standoff. collision_radius is the
; distance the solver holds each particle at from a contact plane, so it has to
; track the tube or the cord sinks into whatever it lies on.
;
; No ribbon_count and no fray: this is one wire. CompositeCable's single-cord path
; anchors the rope's two ends straight to the two plugs, so there is no breakout
; junction for a fray to hang off.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 40
segment_length = 0.03
constraint_iterations = 8
bend_stiffness = 0.15
tube_radius = 0.0018
tube_sides = 8
smoothing = 2
rope_color = Color(0.54, 0.54, 0.52, 1.0)
surface_collision_mask = 7
collision_radius = 0.003
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.3
end_stiff_segments = 2
; A thin link cord's weight, not the default's (an A/V lead's): at 0.04 kg/m its
; push on a 25 to 30 g plug, whose cord leaves it 30 mm and more behind its middle
; (the mods' plugs), outran the plug's own turn and spun it on the floor for good.
linear_density = 0.01
