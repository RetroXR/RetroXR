[gd_scene format=3]

[ext_resource type="PackedScene" uid="uid://ce7vysyvondf8" path="res://addons/godot-xr-tools/objects/snap_zone.tscn" id="1_snapzone"]
[ext_resource type="Script" path="res://Scripts/Objects/cables/svideo_port.gd" id="2_portscript"]
[ext_resource type="PackedScene" path="res://imported-assets/connectors/svideo_port/svideo_socket.glb" id="3_socket"]
[ext_resource type="Script" path="res://Scripts/Objects/highlights/snap_highlight.gd" id="4_snaphigh"]

; The plug's own overmold, so the ghost reads as "an S-Video plug goes here".
[sub_resource type="BoxMesh" id="BoxMesh_plug_ghost"]
size = Vector3(0.0138, 0.0117, 0.02)

[sub_resource type="StandardMaterial3D" id="Mat_plug_ghost"]
transparency = 1
albedo_color = Color(0.2, 0.5, 1, 0.45)
emission_enabled = true
emission = Color(0, 0.15, 0.5, 1)
emission_energy_multiplier = 0.4

; A 4-pin mini-DIN S-Video socket (RetroXR-models generic/svideo-socket). The ZONE is
; the socket's MOUTH face, where a seated plug's origin (its nose face) stops; the model
; has its mouth at its origin and its collar 1.2 mm deep. Its insert's face is about as
; far inside the mouth, so a host with a legend plate stands this zone 2.4 mm off its
; panel (tv.tscn's SvideoIn), or the plate covers the insert. +Y is the key (up).
; `connector` is written HERE as well as in the script (the export trap vga_port.tscn
; describes; link_tests checks the line).
[node name="SvideoPort" instance=ExtResource("1_snapzone")]
grab_distance = 0.05
script = ExtResource("2_portscript")
connector = "svideo_plug"

[node name="SvideoSocket" parent="." instance=ExtResource("3_socket")]

[node name="SnapHighlight" type="Node3D" parent="."]
script = ExtResource("4_snaphigh")

[node name="HighlightMesh" type="MeshInstance3D" parent="SnapHighlight"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.01)
mesh = SubResource("BoxMesh_plug_ghost")
surface_material_override/0 = SubResource("Mat_plug_ghost")
