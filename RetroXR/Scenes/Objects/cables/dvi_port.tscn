; RetroXR-models generic/dvi-socket: the ZONE is the socket's MOUTH, where a seated plug's
; origin (its hood's face) stops; the model has its mouth at its origin, so a host stands this
; zone as far off its panel as the socket's mouth stands proud (TvInputKinds). +Y is the
; connector's wide / latch side. `connector` is written here as well as in the script.
[node name="DviPort" instance=ExtResource("1_snapzone")]
grab_distance = 0.05
script = ExtResource("2_portscript")
connector = "dvi_d_plug"

[node name="DviSocket" parent="." instance=ExtResource("3_socket")]

