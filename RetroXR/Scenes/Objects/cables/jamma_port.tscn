; PLACEHOLDER GEOMETRY, boxes like ilink_port.tscn's: the repo ships only assets it has the right to.
; The JAMMA harness is a 56-way edge connector, here a flat black mouth 60 x 14 mm with the plug's
; own shape as the ghost. Placed so the zone sits where a seated plug's ORIGIN belongs, its mating face.

[sub_resource type="BoxMesh" id="BoxMesh_mouth"]
size = Vector3(0.06, 0.014, 0.008)

; Unshaded near-black, for the other sockets' reason: a shaded one reads as a raised block, not a hole.
[sub_resource type="StandardMaterial3D" id="Mat_mouth"]
albedo_color = Color(0.012, 0.012, 0.015, 1)
shading_mode = 0

[sub_resource type="BoxMesh" id="BoxMesh_plug_ghost"]
size = Vector3(0.06, 0.014, 0.02)

[sub_resource type="StandardMaterial3D" id="Mat_plug_ghost"]
transparency = 1
albedo_color = Color(0.2, 0.5, 1, 0.45)
emission_enabled = true
emission = Color(0, 0.15, 0.5, 1)
emission_energy_multiplier = 0.4

[node name="JammaPort" instance=ExtResource("1_snapzone")]
