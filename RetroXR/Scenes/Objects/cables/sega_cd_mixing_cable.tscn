[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://Scripts/Objects/cables/composite_cable.gd" id="1_cablescript"]
[ext_resource type="Script" path="res://Scripts/Objects/cables/rca_plug.gd" id="2_plugscript"]
[ext_resource type="ArrayMesh" path="res://Scenes/Objects/cables/trs_plug.res" id="3_trsplug"]
[ext_resource type="Script" path="res://Scripts/Objects/highlights/pickable_highlight.gd" id="4_pickhigh"]
[ext_resource type="PackedScene" uid="uid://dh8grd7s3n8kg" path="res://addons/godot-xr-tools/objects/grab_points/grab_point_snap.tscn" id="5_snapgp"]

; The handle and shaft together, centred at z -0.0085 — the plug's ORIGIN is its
; mating face, so the body runs 32 mm back from it and the shaft 15 mm forward.
[sub_resource type="BoxShape3D" id="BoxShape3D_plug"]
size = Vector3(0.012, 0.012, 0.05)

; Sega's handles are black; the baked 3.5 mm plug's are lime and take no tint, so
; its plastic (surface 0) is overridden.
[sub_resource type="StandardMaterial3D" id="Mat_handle"]
albedo_color = Color(0.07, 0.07, 0.075, 1)
roughness = 0.5

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; The laser target only until the plug is in the room: PointerFit then makes it
; a box of what the plug draws (its connector, or a model a mod has put on it)
; and nothing more. Padded so that a beam from across the room could find a
; small plug, it stopped the desktop laser in the air beside the plug and handed
; over the plug instead of whatever was aimed at.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.035, 0.035, 0.075)

; Sega's sound mixing cable, packed with the Sega CD Model 2 "for use with the
; original Genesis model": a 3.5 mm stereo plug at each end, from the Genesis Model
; 1's PHONES into the Sega CD's MIXING (ExpansionAudio). The Model 2 Genesis needs
; none. The trs_cable's lead in black; its 1.0 m length is an ESTIMATE (no reference
; gives it), enough to run from the console's front-left jack round to the drive's
; back.
;
; Otherwise the 3.5 mm lead: ONE cord, a TRS plug at each end.
;
; This is CompositeCable with a single cord, which is all a lead is to that class —
; it counts the cords its scene ships and resolves what they carry from the sockets
; the ends land in. One cord takes the single-rope path in _build_rope: no ribbon,
; no breakout, both ends anchored straight to their plugs.
;
; cord_colors carries the handle's own PC99 lime rather than a signal colour. The
; class tints surface 0 of each plug so a cord can be recognised at both ends, and
; on a one-cord lead there is nothing to tell apart — matching the baked colour
; makes that tint a no-op instead of repainting a connector that is already right.
[node name="SegaCdMixingCable" type="Node3D"]
script = ExtResource("1_cablescript")
cord_colors = PackedColorArray(0.07, 0.07, 0.075, 1)

; -- End A --------------------------------------------------------------------
; Turned about Y so the cord trails toward the far end: the plug mesh is authored
; connector-on-+Z with the cord leaving -Z, which is also VerletRope's
; plug_exit_axis, so an unturned plug here would leave its tail with a hairpin.
[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.45)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.03
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_plugscript")
connector = "trs_plug"

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0085)
shape = SubResource("BoxShape3D_plug")

[node name="PlugTip" type="MeshInstance3D" parent="PlugA0"]
mesh = ExtResource("3_trsplug")
surface_material_override/0 = SubResource("Mat_handle")

[node name="PointerArea" type="StaticBody3D" parent="PlugA0"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0/PointerArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0085)
shape = SubResource("BoxShape3D_pointer")

[node name="PickableHighlight" type="Node3D" parent="PlugA0"]
script = ExtResource("4_pickhigh")

[node name="SnapGrabPoint" parent="PlugA0" instance=ExtResource("5_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

; -- End B --------------------------------------------------------------------
; Unturned: its cord already trails -Z, back toward end A.
[node name="PlugB0" type="RigidBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.45)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.03
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_plugscript")
connector = "trs_plug"

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugB0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0085)
shape = SubResource("BoxShape3D_plug")

[node name="PlugTip" type="MeshInstance3D" parent="PlugB0"]
mesh = ExtResource("3_trsplug")
surface_material_override/0 = SubResource("Mat_handle")

[node name="PointerArea" type="StaticBody3D" parent="PlugB0"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugB0/PointerArea"]
