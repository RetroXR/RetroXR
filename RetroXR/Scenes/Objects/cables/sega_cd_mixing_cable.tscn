[node name="SnapGrabPoint" parent="PlugB0" instance=ExtResource("5_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

; 40 x 25 mm = 1.0 m (estimated). controller_cable's
; tuning rather than the A/V lead's: this is a thin 4.5 mm cord, not an 8.3 mm
; shielded jacket, so it wants the softer bend and the tighter standoff.
; collision_radius is the standoff the solver holds each particle at from a contact
; plane, so it has to track the tube or the cord sinks into whatever it lies on.
;
; No ribbon_count and no fray: this is one wire. CompositeCable's single-cord path
; anchors the rope's two ends straight to the two plugs, so there is no breakout
; junction for a fray to hang off.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 40
segment_length = 0.025
constraint_iterations = 8
bend_stiffness = 0.15
tube_radius = 0.00225
tube_sides = 8
smoothing = 2
rope_color = Color(0.06, 0.06, 0.065, 1.0)
surface_collision_mask = 7
collision_radius = 0.0036
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.3
end_stiff_segments = 2
