; End A, the EXT.2 plug: a hood the cord leaves from the back of, and the nose
; that goes into the socket in front of its face (the plug's ORIGIN, as on every
; plug here). Stand-in boxes; a mod puts the measured plug on.
[sub_resource type="BoxMesh" id="BoxMesh_hood"]
material = SubResource("Mat_plastic")
size = Vector3(0.0135, 0.0065, 0.016)

[sub_resource type="BoxMesh" id="BoxMesh_nose"]
material = SubResource("Mat_plastic")
size = Vector3(0.0102, 0.0042, 0.006)

[sub_resource type="BoxShape3D" id="BoxShape3D_hood"]
size = Vector3(0.0135, 0.0065, 0.022)

; End B, the jack: a short barrel with the 3.5 mm socket in its front face.
[sub_resource type="CylinderMesh" id="CylMesh_barrel"]
material = SubResource("Mat_plastic")
top_radius = 0.0055
bottom_radius = 0.0055
height = 0.022

[sub_resource type="BoxShape3D" id="BoxShape3D_barrel"]
size = Vector3(0.011, 0.011, 0.022)

; The laser target until PointerFit refits it to what the plug draws.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.035, 0.035, 0.045)

; The Game Boy Advance SP's headphone adapter: an EXT.2 plug, a short cord and a
; 3.5 mm jack (PhonesAdapter). The SP has no jack of its own; while this is in
; its EXT.2, a 3.5 mm lead from the jack carries the SP's sound, as one from a
; handheld's own jack does.
;
; One cord, so CompositeCable's single-rope path: both ends anchored straight to
; their bodies. End B fits nothing ("phones_adapter_body" is no socket's) -- it is
; the jack, and it hangs.
[node name="SpPhonesAdapter" type="Node3D"]
script = ExtResource("1_adapter")
cord_colors = PackedColorArray(0.12, 0.12, 0.13, 1)

; -- End A: the EXT.2 plug ---------------------------------------------------
; Turned about Y so the cord trails toward the jack (connector on +Z, cord out of
; -Z, which is VerletRope's plug_exit_axis), as trs_cable.tscn's end A is.
[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.05)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.008
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_plugscript")
connector = "ext2_plug"

