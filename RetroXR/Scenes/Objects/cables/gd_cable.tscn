; 16 x 30 mm = 0.48 m: the run from the DIMM board to the drive in the NAOMI Universal's back corner (about 0.43 m) and
; a little slack. At 0.75 its slack looped out over the base's wall and the top panel shut through it (the owner,
; 2026-11-15: "don't have the wires clip through the wall"). Bought with segment COUNT so the boot and the bend radius stay
; as tuned.
;
; 8.7 mm cord (tube_radius 0.00435, the hood's cord hole), collision_radius 0.0057 (the 1.35 mm resting gap the
; other leads use).
;
; No ribbon_count and no fray: this is one wire. CompositeCable's single-cord path
; anchors the rope's two ends straight to the two plugs, so there is no breakout
; junction for a fray to hang off.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 16
segment_length = 0.03
constraint_iterations = 8
bend_stiffness = 0.2
tube_radius = 0.00435
tube_sides = 8
smoothing = 2
rope_color = Color(0.84, 0.82, 0.75, 1.0)
surface_collision_mask = 7
collision_radius = 0.0057
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.45
end_stiff_segments = 2
