[ext_resource type="PackedScene" uid="uid://dh8grd7s3n8kg" path="res://addons/godot-xr-tools/objects/grab_points/grab_point_snap.tscn" id="4_snapgp"]

; PLACEHOLDER GEOMETRY. Two boxes, not a model.
;
; Every other connector in the room is an authored mesh, and this one will want to
; be as well. It is primitives for now for one reason: the repo ships only assets
; it has the right to, and a GBA link connector is not something to guess at with
; someone else's export. Boxes are generated, so they carry no licence at all.
;
; The numbers are still real, because the scale is what everything else keys off:
; a link plug's shell is about 13 x 9 mm and 20 mm deep, with a smaller keyed nose
; standing 7 mm proud of the mating face. Replacing this with a model that keeps
; those dimensions needs no other change.
;
; Black cord, black shells, bare metal on both noses. The original Game Boy's
; DMG-04 (dmg_link_cable.tscn) inherits this scene with the large shell.

; The shell, running BACK from the mating face. The plug's ORIGIN is that face,
; which is the convention every port in the room places against, so the body is
; offset half its depth along -Z rather than sitting centred on the origin.
[sub_resource type="BoxMesh" id="BoxMesh_body"]
size = Vector3(0.013, 0.009, 0.02)

[sub_resource type="StandardMaterial3D" id="Mat_shell_black"]
albedo_color = Color(0.07, 0.07, 0.08, 1)
roughness = 0.55

; The keyed nose, forward of the mating face — the part that actually enters the
; socket. Separate from PlugTip on purpose: RcaPlug derives the cord's exit from
; PlugTip's AABB alone, so folding the nose into that mesh would push the anchor
; forward and run the tail out through the barrel.
[sub_resource type="BoxMesh" id="BoxMesh_nose"]
size = Vector3(0.0085, 0.0055, 0.007)

; Bare metal on both ends, as on the real connector, but only lightly metallic.
; A fully metallic surface takes its colour from what it reflects, and a room
; with no sky and no reflection probe gives it almost nothing to reflect — the
; nose then renders near-black in exactly the dim corners a handheld gets used
; in. Mostly-diffuse with a little specular reads as brushed metal anywhere.
[sub_resource type="StandardMaterial3D" id="Mat_nose"]
albedo_color = Color(0.72, 0.71, 0.69, 1)
metallic = 0.25
metallic_specular = 0.75
roughness = 0.4

; Shell and nose together, 27 mm end to end, centred 6.5 mm behind the face.
[sub_resource type="BoxShape3D" id="BoxShape3D_plug"]
size = Vector3(0.013, 0.009, 0.027)

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; The laser target only until the plug is in the room: PointerFit then makes it
; a box of what the plug draws (its connector, or a model a mod has put on it)
; and nothing more. Padded so that a beam from across the room could find a
; small plug, it stopped the desktop laser in the air beside the plug and handed
; over the plug instead of whatever was aimed at.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.035, 0.035, 0.06)

; A Game Boy Color link cable (CGB-003): ONE cord, the SMALL link plug at each
; end, and nothing in the middle. The Pocket and the Color shrank the original's
; connector, so this fits a Color or an Advance and not an original Game Boy or
; the Printer -- those take the DMG-04, or this lead through the DMG-14 adapter.
;
; A separate lead from the Game Boy Advance's rather than a recolour of it,
; because the two differ in the one way that shows: the GBA lead carries an
; inline junction so a third and fourth machine can chain onto the wire, and a
; Game Boy link is two machines and no more. A junction here would be a socket
; that took a plug and joined nobody.
;
; Both shells are the same colour, which the GBA lead's are not. There, end A is
; purple because it is the one handed to LinkConnect first and its machine owns
; the clock. A Game Boy has no such end: whichever unit selects the internal
; clock drives the transfer, and that is the guest's choice, so there is nothing
; for a colour to tell you.
;
; LinkCable rather than CompositeCable, which is the only difference that matters.
; It inherits the whole lead — rope, clamping, seating persistence, multiplayer
; replication of which end sits where — and changes only what a seated pair MEANS:
; two cores told they share a wire, instead of a routing decision.
;
; No cord_colors, and LinkCable overrides _tint_plug to leave the shells alone.
; That palette exists so the WIRES of a multi-cord lead can be told apart at both
; ends; this lead has one wire and its two ends differ by ROLE instead. End A is
; always the one handed to LinkConnect first, so its machine takes bus index 0
; and owns the clock — which on the real cable is the purple connector, with the
; secondary in grey. Painting both from a one-entry palette would erase exactly
; the distinction worth seeing.
[node name="LinkCable" type="Node3D"]
script = ExtResource("1_cablescript")

; -- End A --------------------------------------------------------------------
; Turned about Y so the cord trails toward the far end: the plug is authored
; connector-on-+Z with the cord leaving -Z, which is also VerletRope's
; plug_exit_axis, so an unturned plug here would leave its tail with a hairpin.
[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.48)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.025
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_plugscript")

