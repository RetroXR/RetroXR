[node name="SnapGrabPoint" parent="PlugB0" instance=ExtResource("5_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

; 45 x 40 mm = 1.80 m, the length a DOL-011 ships at, against 1.40 m between the
; plugs so it hangs. Same tuning as the link lead: a thin cord, not a shielded
; A/V jacket, so it wants the softer bend and the tighter standoff.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 45
segment_length = 0.04
constraint_iterations = 8
stretch_stiffness = 1.0
bend_stiffness = 0.1
damping = 0.01
end_align_stiffness = 0.14
end_stiffness = 0.2
end_stiff_segments = 1
tube_radius = 0.002
tube_sides = 8
smoothing = 2
rope_color = Color(0.35, 0.24, 0.58, 1.0)
surface_collision_mask = 7
collision_radius = 0.003
self_collision = true
; A thin link cord's weight, not the default's (an A/V lead's): at 0.04 kg/m its
; push on a 25 to 30 g plug, whose cord leaves it 30 mm and more behind its middle
; (the mods' plugs), outran the plug's own turn and spun it on the floor for good.
linear_density = 0.01
