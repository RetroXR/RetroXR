[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugB0/PointerArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0065)
shape = SubResource("Shape_gcpointer")

[node name="PickableHighlight" type="Node3D" parent="PlugB0"]
