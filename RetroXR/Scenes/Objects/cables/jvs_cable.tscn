; 60 x 30 mm = 1.80 m. A cabinet's cord is cut to its run (NaomiHookup, CaptiveCord.resize).
;
; 4.6 mm cord (tube_radius 0.0023): a USB cable's jacket, not the VGA lead's 7.5 (the owner,
; 2026-11-14: "the usb cable seems kinda thick"). collision_radius tracks the tube, 1.35 mm
; out, as the other leads do.
;
; No ribbon_count and no fray: this is one wire. CompositeCable's single-cord path
; anchors the rope's two ends straight to the two plugs, so there is no breakout
; junction for a fray to hang off.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 60
segment_length = 0.03
constraint_iterations = 8
bend_stiffness = 0.2
tube_radius = 0.0023
tube_sides = 8
smoothing = 2
rope_color = Color(0.05, 0.05, 0.06, 1.0)
surface_collision_mask = 7
collision_radius = 0.00365
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.45
end_stiff_segments = 2
