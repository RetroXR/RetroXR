; -- End B --------------------------------------------------------------------
; Unturned: its cord already trails -Z, back toward end A.
;
; Its Shell is the USB-B plug model, carried two ways:
; - Rolled half round about Z, so the shell's chamfered corners (the model's +Y) face
;   this body's -Y. A socket seats a plug with the plug's +Y along the socket's -Y
;   (the SnapGrabPoint's half turn about X), which on a board lying flat is down; a
;   right-angle USB-B receptacle on a board has its chamfered corners up, away from
;   the board (USB 2.0 Figure 6-14), on the converter's CN2 and the I/O board's CN4
;   alike, so the roll puts the plug's chamfers to the receptacle's.
; - 3.12 mm back, so that seated (this body's origin on the socket's mouth) the
;   shell's front reaches the receptacle's stop 8.88 mm in and the boot stands 3.12 mm
;   off its face, as USB 2.0 Figure 6-8 mates them (2.67 MIN), instead of the boot
;   pressed flat to the receptacle with the shell's tip 3.12 mm past its back wall.
; CordExit and the collision box follow the model there.
[node name="PlugB0" type="RigidBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.75)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.06
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_plugscript")
connector = "usb_b"

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugB0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.015795)
shape = SubResource("BoxShape3D_usbb")

[node name="Shell" parent="PlugB0" instance=ExtResource("7_usbb")]
transform = Transform3D(-1, 0, 0, 0, -1, 0, 0, 0, 1, 0, 0, -0.00312)

[node name="CordExit" type="Marker3D" parent="PlugB0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.04047)

[node name="PointerArea" type="StaticBody3D" parent="PlugB0"]
