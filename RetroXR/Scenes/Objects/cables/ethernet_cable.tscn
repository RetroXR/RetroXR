[ext_resource type="PackedScene" uid="uid://0q1105qtvk8e" path="res://imported-assets/connectors/rj45_plug/rj45_plug.glb" id="5_rj45"]

; Each end wears the RJ45 (8P8C) plug, RetroXR-models generic/rj45-plug
; (imported-assets/connectors/rj45_plug): the clear body with its eight gold
; contacts and the wires behind them, the latch, a blue moulded boot. It was the
; xenu.rj45 mod's until it came into the game.
;
; The model's origin is where the jack's face is with the plug latched home, which
; is the plug's ORIGIN here, the convention every Ethernet socket places at its
; mouth. Its latch is its +Y; a plug goes in through a grab point turned half about
; X, which leaves the plug's +Y against the socket's -Y, and a socket's +Y is the
; latch's side (ExpansionCatalog's `jack`), so the Shell is rolled half round about
; Z. CordExit is the model's, rolled with it: where the cord leaves the boot.

; The model's bounds, rolled: 12.9 x 10.6 x 35.5 mm, its tip 8.4 mm ahead of the face.
[sub_resource type="BoxShape3D" id="BoxShape3D_plug"]
size = Vector3(0.012884, 0.010573, 0.0355)

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; The laser target only until the plug is in the room -- see ilink_cable.tscn.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.04, 0.04, 0.06)

; A 2.4 m patch lead: long enough to reach a hub on the floor from a console on a
; table, the way a LAN party was cabled.
[node name="EthernetCable" type="Node3D"]
script = ExtResource("1_cablescript")

