; PLACEHOLDER GEOMETRY, for saturn_link_cable.tscn's reason: boxes are generated,
; so they carry no licence at all. The numbers are real.
;
; An RJ45 (8P8C) plug: a clear body 11.7 mm wide and 8 mm tall that goes ALL the
; way into the jack, about 15 mm of it, with a sprung latch along its top; behind
; it a moulded boot about 13 x 10 mm where the cord comes out. Both ends the same:
; Ethernet through a hub is a bus of peers, and either end goes in an adapter or
; in a hub.

; The boot, running BACK from the mating face -- the plug's ORIGIN, the convention
; every port in the room places against. Cat5 blue.
[sub_resource type="BoxMesh" id="BoxMesh_boot"]
size = Vector3(0.013, 0.01, 0.018)

[sub_resource type="StandardMaterial3D" id="Mat_boot"]
albedo_color = Color(0.13, 0.3, 0.68, 1)
roughness = 0.55

; The body, forward of the face: everything that enters the jack. Separate from
; PlugTip, because RcaPlug derives the cord's exit from PlugTip's AABB alone.
[sub_resource type="BoxMesh" id="BoxMesh_body"]
size = Vector3(0.0117, 0.008, 0.015)

; Clear polycarbonate, lightly tinted so it reads against a dark socket.
[sub_resource type="StandardMaterial3D" id="Mat_body"]
transparency = 1
albedo_color = Color(0.85, 0.88, 0.9, 0.55)
roughness = 0.2

; The eight gold contacts, as one strip across the nose's underside.
[sub_resource type="BoxMesh" id="BoxMesh_contacts"]
size = Vector3(0.0085, 0.0012, 0.0035)

[sub_resource type="StandardMaterial3D" id="Mat_contacts"]
albedo_color = Color(0.85, 0.66, 0.25, 1)
metallic = 0.25
metallic_specular = 0.75
roughness = 0.35

; The latch, a tongue along the top of the body.
[sub_resource type="BoxMesh" id="BoxMesh_latch"]
size = Vector3(0.0055, 0.0015, 0.012)

; Boot and body together, 33 mm end to end, centred 1.5 mm behind the face.
[sub_resource type="BoxShape3D" id="BoxShape3D_plug"]
size = Vector3(0.013, 0.01, 0.033)

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; The laser target only until the plug is in the room -- see ilink_cable.tscn.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.04, 0.04, 0.06)

; A 2.4 m patch lead: long enough to reach a hub on the floor from a console on a
; table, the way a LAN party was cabled.
[node name="EthernetCable" type="Node3D"]
script = ExtResource("1_cablescript")

; -- End A --------------------------------------------------------------------
; Turned about Y so the cord trails toward the far end -- see saturn_link_cable.
[node name="PlugA0" type="RigidBody3D" parent="."]
