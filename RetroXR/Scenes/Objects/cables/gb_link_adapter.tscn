shape = SubResource("BoxShape3D_pointer")

[node name="PickableHighlight" type="Node3D" parent="PlugB0"]
script = ExtResource("3_pickhigh")

[node name="SnapGrabPoint" parent="PlugB0" instance=ExtResource("4_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

; The small socket on the BACK face, mouth outward: a port's +Z points out of what
; it is a socket on, and out of this block's back is the plug's -Z, so it is the
; plug's frame turned half round Y. Its zone is where a seated small plug's mating
; face belongs, flush with the back of the block.
[node name="LinkPort" parent="PlugB0" instance=ExtResource("5_linkport")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.016)
