; PLACEHOLDER GEOMETRY. Boxes, not a model, for the reason the GBA lead's are:
; the repo ships only assets it has the right to, and a Sony connector is not
; something to guess at with someone else's export. Boxes are generated, so they
; carry no licence at all.
;
; The numbers are real, because the scale is what everything else keys off. The
; SCPH-1040's connector is a shrouded rectangular shell about 21 x 11 mm and
; 24 mm deep, with a keyed nose standing 7 mm proud of the mating face -- roughly
; twice the GBA connector in every direction, because this is a panel socket on
; the back of a console rather than something on a handheld.
;
; The colour is the light grey Sony moulded everything of that era in, cord
; included. Both shells the same: unlike the GBA lead there is no purple end and
; no grey one, because there is no player one.

; The shell, running BACK from the mating face. The plug's ORIGIN is that face,
; which is the convention every port in the room places against, so the body is
; offset half its depth along -Z rather than sitting centred on the origin.
[sub_resource type="BoxMesh" id="BoxMesh_body"]
size = Vector3(0.018, 0.0068, 0.024)

[sub_resource type="StandardMaterial3D" id="Mat_shell"]
albedo_color = Color(0.62, 0.61, 0.58, 1)
roughness = 0.65

; The keyed nose, forward of the mating face -- the part that actually enters the
; socket. Separate from PlugTip on purpose: RcaPlug derives the cord's exit from
; PlugTip's AABB alone, so folding the nose into that mesh would push the anchor
; forward and run the tail out through the barrel.
[sub_resource type="BoxMesh" id="BoxMesh_nose"]
size = Vector3(0.014, 0.0028, 0.007)

; Bare metal on the nose, lightly metallic. A fully metallic surface takes its
; colour from what it reflects, and a room with no sky and no reflection probe
; gives it almost nothing to reflect -- it then renders near-black in exactly the
; dim corners a console's back panel lives in.
[sub_resource type="StandardMaterial3D" id="Mat_nose"]
albedo_color = Color(0.72, 0.71, 0.69, 1)
metallic = 0.25
metallic_specular = 0.75
roughness = 0.4

; Shell and nose together, 31 mm end to end, centred 8.5 mm behind the face.
[sub_resource type="BoxShape3D" id="BoxShape3D_plug"]
size = Vector3(0.018, 0.0068, 0.031)

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; Laser target, deliberately larger than the physics box, so a beam from across
; the room can find a connector on the back of a console. Only the pointer
; answers this shape (mask 0), so nothing else notices it is generous.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.042, 0.042, 0.07)

; A 1.5 m PlayStation link cable: ONE cord, an identical plug at each end.
;
; No cord_colors, and _tint_plug is overridden to leave the shells alone. That
; palette exists so the WIRES of a multi-cord lead can be told apart at both
; ends; this lead has one wire, and its two ends do not differ at all -- which is
; the point. Either end goes in either console.
[node name="SaturnLinkCable" type="Node3D"]
script = ExtResource("1_cablescript")

; -- End A --------------------------------------------------------------------
; Turned about Y so the cord trails toward the far end: the plug is authored
; connector-on-+Z with the cord leaving -Z, which is also VerletRope's
; plug_exit_axis, so an unturned plug here would leave its tail with a hairpin.
[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, -0.6)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_plug")
mass = 0.03
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_plugscript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0085)
shape = SubResource("BoxShape3D_plug")

[node name="PlugTip" type="MeshInstance3D" parent="PlugA0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.012)
mesh = SubResource("BoxMesh_body")
surface_material_override/0 = SubResource("Mat_shell")

[node name="PlugNose" type="MeshInstance3D" parent="PlugA0"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.0035)
mesh = SubResource("BoxMesh_nose")
surface_material_override/0 = SubResource("Mat_nose")

[node name="PointerArea" type="StaticBody3D" parent="PlugA0"]
