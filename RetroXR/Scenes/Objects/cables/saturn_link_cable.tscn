; 50 x 30 mm = 1.50 m, the length the SCPH-1040 ships at, against 1.20 m between
; the plugs so it hangs rather than pulling straight.
;
; The GBA lead's solver tuning, with a slightly fatter tube: this is a thin cord
; rather than an 8.3 mm shielded A/V jacket, so it wants the softer bend and the
; tighter standoff. collision_radius is the distance the solver holds each
; particle at from a contact plane, so it has to track the tube or the cord sinks
; into whatever it lies on.
;
; No ribbon_count and no fray: this is one wire. CompositeCable's single-cord path
; anchors the rope's two ends straight to the two plugs, so there is no breakout
; junction for a fray to hang off.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 50
segment_length = 0.03
constraint_iterations = 8
bend_stiffness = 0.15
tube_radius = 0.0022
tube_sides = 8
smoothing = 2
rope_color = Color(0.6, 0.59, 0.56, 1.0)
surface_collision_mask = 7
collision_radius = 0.0035
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.3
end_stiff_segments = 2
