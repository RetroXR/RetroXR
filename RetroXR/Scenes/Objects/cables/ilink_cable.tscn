[node name="SnapGrabPoint" parent="PlugB0" instance=ExtResource("4_snapgp")]
transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0)

; 60 x 30 mm = 1.80 m against 1.40 m between the plugs, so it hangs. The Saturn
; lead's solver tuning with a slightly thinner tube: a 4-pin 1394 cord is about
; 4 mm across.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 60
segment_length = 0.03
constraint_iterations = 8
bend_stiffness = 0.15
tube_radius = 0.002
tube_sides = 8
smoothing = 2
rope_color = Color(0.09, 0.09, 0.1, 1.0)
surface_collision_mask = 7
collision_radius = 0.0035
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.3
end_stiff_segments = 2
