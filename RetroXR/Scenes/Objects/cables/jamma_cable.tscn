[ext_resource type="PackedScene" uid="uid://beg5d4c0ulu8a" path="res://imported-assets/connectors/jamma_plug/jamma_plug.glb" id="5_jammaplug"]

; Each end wears the JAMMA harness plug (RetroXR-models generic/jamma-plug, the keyed model,
; imported-assets/connectors/jamma_plug): the blue 56-way 3.96 mm card-edge socket (EDAC
; 307-056-500-202) with its ears, the lead-in and the 28 + 28 bellows contacts in their pockets,
; the polarizing key in position 7, the eyelet tails, and the harness's 50 wires fanning up off
; its numbered side into a black taped loom 14 mm across with a cable tie. Both ends the same,
; so either end goes on a converter's or a board's edge, or in a cabinet's socket.
;
; How it is turned. The model's frame: its slot opens toward +Z, the origin on the slot's
; bottom (where the board edge's tip sits, which is where every JAMMA port stands), position 1
; on +X, the numbered (component) side +Y. A socket seats the plug half a turn about X
; (SnapGrabPoint), so Shell is half a turn about Z: together the model's numbered side
; lies along the socket's +Y and its position 1 toward the socket's -X, which on the JVS-to-JAMMA
; converter (+Y its component side, pin 1 toward -X) puts the key over the edge's key slot.
; The harness leaves the loom along the model's +Y (plug -Y): the rope's exit axes say so.

; The connector's own box: ears 133.96 across, 12.7 through, from the tails' tips to the slot
; face (19.17), centred 1.97 mm behind the plug's origin.
[sub_resource type="BoxShape3D" id="BoxShape3D_plug"]
size = Vector3(0.13396, 0.0127, 0.01917)

; The fan of wires and the loom (plug frame: the model's +Y is the plug's -Y): wide at the tails,
; narrowing up to the loom 14 mm across; it stops 8 mm short of the loom's top, so the cord
; leaving there does not start inside its own plug.
[sub_resource type="ConvexPolygonShape3D" id="ConvexShape_fan"]
points = PackedVector3Array(-0.055, 0.0034, -0.01155, 0.055, 0.0034, -0.01155, -0.055, 0.0034, -0.022, 0.055, 0.0034, -0.022, -0.0075, -0.055, -0.015, 0.0075, -0.055, -0.015, -0.0075, -0.055, -0.0305, 0.0075, -0.055, -0.0305)

[sub_resource type="PhysicsMaterial" id="PhysMat_plug"]
bounce = 0.0
friction = 0.8

; Laser target, the model's bounds (PointerFit fits it to what the plug draws once it is in the
; room). Only the pointer answers it (mask 0).
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.134, 0.06935, 0.03817)

