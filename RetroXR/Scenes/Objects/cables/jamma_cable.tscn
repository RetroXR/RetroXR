surface_collision_mask = 7
collision_radius = 0.009
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.3
end_stiff_segments = 2
start_exit_axis = Vector3(0, -1, 0)
end_exit_axis = Vector3(0, -1, 0)
