; 60 x 30 mm = 1.80 m, the length a VGA lead shipped at. Bought with segment COUNT
; rather than a longer segment, so the boot and the minimum bend radius stay where
; cable.tscn tuned them in millimetres.
;
; 7.5 mm cord (tube_radius 0.00375) — a shielded VGA lead is nearly double the
; 4.5 mm controller cord and close to the composite lead's jacket. collision_radius
; is the standoff the solver holds each particle at from a contact plane, so it has
; to track the tube or the cord sinks: 0.0051 leaves the same 1.35 mm resting gap
; the other leads use.
;
; No ribbon_count and no fray: this is one wire. CompositeCable's single-cord path
; anchors the rope's two ends straight to the two plugs, so there is no breakout
; junction for a fray to hang off.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 60
segment_length = 0.03
constraint_iterations = 8
bend_stiffness = 0.2
tube_radius = 0.00375
tube_sides = 8
smoothing = 2
rope_color = Color(0.05, 0.05, 0.06, 1.0)
surface_collision_mask = 7
collision_radius = 0.0051
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.45
end_stiff_segments = 2
