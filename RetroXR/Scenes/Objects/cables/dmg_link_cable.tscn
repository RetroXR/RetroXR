[ext_resource type="PackedScene" path="res://Scenes/Objects/cables/gb_link_cable.tscn" id="1_base"]

; The DMG-04 Game Link Cable: the original Game Boy's lead, the large connector on
; both ends. The base lead's cord and colours (black, as the DMG-04 is) with the
; large shell and its own plug family, so it seats in an original Game Boy
; (dmg_link_port.tscn) and in nothing smaller. A Game Boy Color, or the Game Boy
; Printer, joins the same wire with the small lead through the DMG-14 adapter.
;
; Sizes from RetroXR-models' MEASUREMENTS.md for nintendo/gb/link-plug and
; nintendo/gbc/universal-link-adapter (read off photographs, scaled by the nose).
; The plug's origin is still its mating face.

; The body, 17.8 x 9.8, running back 25.7 mm from the mating face.
[sub_resource type="BoxMesh" id="BoxMesh_body_dmg"]
size = Vector3(0.0178, 0.0098, 0.0257)

; The nickel nose, 12.0 x 5.6, standing 11 mm proud of the face.
[sub_resource type="BoxMesh" id="BoxMesh_nose_dmg"]
size = Vector3(0.012, 0.0056, 0.011)

; Body and nose together, 36.7 mm end to end, centred 7.35 mm behind the face.
