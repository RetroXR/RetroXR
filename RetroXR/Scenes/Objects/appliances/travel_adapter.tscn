; ── TravelAdapter: the region's prongs in front, a universal socket behind ─────
;
; The whole adapter is its WallPlug: what the hand carries and the wall holds. The
; root never moves. TravelAdapter.set_region swaps the mesh for the region's
; prongs and fits the boxes and the socket to it; the numbers here are the US
; one's.
[node name="TravelAdapter" type="Node3D"]
script = ExtResource("1_adapter")

[node name="WallPlug" type="RigidBody3D" parent="."]
collision_layer = 4
collision_mask = 196613
