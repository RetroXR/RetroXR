; The cabinet above the feet: 260 x 286 x 280 mm centred 157 mm up.
[sub_resource type="BoxShape3D" id="Shape_box"]
size = Vector3(0.26, 0.286, 0.28)

[sub_resource type="BoxShape3D" id="Shape_pointer"]
size = Vector3(0.29, 0.31, 0.31)

; The subwoofer: a front-firing 165 mm driver over a front port, on four feet.
;
; A Loudspeaker (Subwoofer extends it) — a cabinet with one cone and one phono
; input, what it carries decided by the television socket its lead sits in — with
; an amplifier plate: its own mains cord and a rocker power switch, built in _ready
; on the model's PowerCordExit and PowerRocker (subwoofer.gd).
;
; Heavier and higher-friction than the satellite: a sub gets nudged by a foot
; rather than picked up, and should stay where it is put.
[node name="Subwoofer" type="RigidBody3D"]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_box")
mass = 6.5
linear_damp = 6.0
angular_damp = 9.0
freeze_mode = 1
script = ExtResource("1_spk")
speaker_label = "LFE IN"

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.157, 0)
shape = SubResource("Shape_box")

; The old baked cabinet, kept as an empty node (saves and probes name it); the model draws the cabinet now.
[node name="Cabinet" type="MeshInstance3D" parent="."]

; The RETRO XR model (RetroXR-models generic/subwoofer), three levels by distance. The scene's
; nodes are dressed from it in _ready (Loudspeaker._dress): the jack on its mouth, the cone on its driver, the
; boxes fitted to what it draws.
[node name="Model" type="Node3D" parent="."]
script = ExtResource("5_model")
level_scenes = Array[PackedScene]([ExtResource("6_lod0"), ExtResource("7_lod1"), ExtResource("8_lod2")])

; The driver's face, 190 mm up the baffle.
[node name="ConeFront" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.19, 0.145)

; Rx(180), so the socket's +Z leaves the back panel. Listed by ROWS.
[node name="SpeakerIn" parent="." instance=ExtResource("4_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, -8.74228e-08, 0, 8.74228e-08, -1, 0, 0.075, -0.1505)
channel = 8
direction = 1

[node name="BackLabel" type="Label3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0.115, -0.1402)
pixel_size = 0.001
text = "LFE IN"
font_size = 8
outline_size = 0
modulate = Color(0.55, 0.55, 0.58, 1)

