[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("BoxShape3D_body")

; The old grey box, kept as a node (DVDBody is the housing a combo set hides, and a name the scripts know) but no
; longer drawn: the RETRO XR model below is the player. See ApplianceModel and DVDPlayer._dress.
[node name="DVDBody" type="MeshInstance3D" parent="."]
visible = false
mesh = SubResource("BoxMesh_body")
surface_material_override/0 = SubResource("Mat_body")

; Before PickableHighlight, whose _ready outlines every mesh already under the player.
[node name="Model" type="Node3D" parent="."]
script = ExtResource("9_model")
level_scenes = Array[PackedScene]([ExtResource("10_lod0"), ExtResource("11_lod1"), ExtResource("12_lod2")])

[node name="PickableHighlight" type="Node3D" parent="."]
script = ExtResource("5_pickhigh")

; On the model's tray when it is OUT (DiscSeat at the end of Open, a 4 mm disc's center 2 mm over the well's floor):
; a disc goes in only there. The zone is on only while the tray is out and empty (DVDPlayer._sync_slot).
[node name="DiscSlot" parent="." instance=ExtResource("2_snapzone")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.115, 0.0185, 0.2095)
grab_distance = 0.09
snap_require = "dvd_disc"

[node name="SlotVisual" type="MeshInstance3D" parent="DiscSlot"]
visible = false
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.006)
mesh = SubResource("BoxMesh_slot")
surface_material_override/0 = SubResource("Mat_slot")

[node name="SnapHighlight" type="Node3D" parent="DiscSlot"]
script = ExtResource("4_snaphis")

[node name="HighlightMesh" type="MeshInstance3D" parent="DiscSlot/SnapHighlight"]
mesh = SubResource("Cyl_disc_ghost")
surface_material_override/0 = SubResource("Mat_disc_ghost")

; A/V out on the back panel. The deck no longer carries a captive lead — a
; composite cable is spawned and plugged in, and what plays depends on which of
; these three a cord reaches (see CompositeCable).
;
; Turned 180 degrees about X so each socket's local +Z points out of the back of
; the deck, and standing 10 mm proud of the 0.25 m-deep body at z = -0.125, which
; is where a seated plug's origin belongs; the jack inside each port is offset
; back onto the panel. Same convention as the television's ports.

[node name="VideoOut" parent="." instance=ExtResource("8_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.082, 0, -0.155)
channel = 0
direction = 0

[node name="AudioLOut" parent="." instance=ExtResource("8_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.1, 0, -0.155)
channel = 1
direction = 0

[node name="AudioROut" parent="." instance=ExtResource("8_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.118, 0, -0.155)
channel = 2
direction = 0

