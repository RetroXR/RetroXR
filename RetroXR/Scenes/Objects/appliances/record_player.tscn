[sub_resource type="PhysicsMaterial" id="PhysMat_rp"]
friction = 0.8

; The plinth on its feet: the model's feet stand on y -0.03, where the old primitive
; plinth's underside was, so a deck saved on a table is still on it. Up to the deck
; plate (y 0.06); the dust cover has a shape of its own below.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.46, 0.09, 0.4)

; The closed dust cover, so a thing set on it rests on it. Disabled while the cover is
; open (record_player.gd), when this box would hang in the air over the platter.
[sub_resource type="BoxShape3D" id="BoxShape3D_cover"]
size = Vector3(0.452, 0.075, 0.39)

; What the laser hits. A pickable is ray-grabbed through a PointerArea child on the
; pointable layer (function_pickup._resolve_pickable), never through its own body,
; which the pointer's RayCast does not mask. The plinth plus 10 mm in X and at the
; back; its top stops 5 mm UNDER the deck plate and its front 2 mm behind the plinth's
; face, so the 33/45 keys on the deck and START-STOP on the front band stand proud of
; it and a ray aimed at a key reaches the key first.
[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.48, 0.085, 0.408)

[sub_resource type="CylinderMesh" id="Cyl_record_ghost"]
top_radius = 0.151
bottom_radius = 0.151
height = 0.0019

[sub_resource type="StandardMaterial3D" id="Mat_record_ghost"]
transparency = 1
albedo_color = Color(0.2, 0.5, 1, 0.4)
emission_enabled = true
emission = Color(0, 0.15, 0.5, 1)

; Placeholder boxes; ApplianceModel.adopt_button() replaces each key's with the model's
; own key and fits the box to it.
[sub_resource type="BoxShape3D" id="BoxShape3D_btn"]
size = Vector3(0.03, 0.02, 0.03)

[sub_resource type="SphereShape3D" id="Shape_armgrab"]
radius = 0.028

; The cover's front lip, where a hand takes it.
[sub_resource type="BoxShape3D" id="Shape_coverlip"]
size = Vector3(0.3, 0.03, 0.02)

[sub_resource type="BoxShape3D" id="Shape_knobgrab"]
size = Vector3(0.018, 0.014, 0.024)

; RETRO XR turntable (RetroXR-models generic/turntable): its three levels under Model,
; dressed by record_player.gd. arm_* are calibrated from the model's tonearm (see
; ArmMount below and docs/dev/record-player.md).
[node name="RecordPlayer" type="RigidBody3D" groups=["record_player"]]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_rp")
freeze_mode = 1
linear_damp = 5.0
angular_damp = 8.0
script = ExtResource("1_rpscript")
player_label = "RECORD PLAYER"
arm_park = 0.5135
arm_lead_in = 0.5471
arm_lead_out = 1.0

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.015, 0)
shape = SubResource("BoxShape3D_body")

[node name="CoverShape" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0975, 0.0005)
shape = SubResource("BoxShape3D_cover")
disabled = true

; The model's origin is the middle of its box (feet to the closed cover's top, 165 mm),
; so +52.5 mm puts its feet on y -0.03 and its deck plate at y 0.06. BEFORE
; PickableHighlight, so its levels exist when the highlight collects meshes.
[node name="Model" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0525, 0)
script = ExtResource("8_model")
level_scenes = Array[PackedScene]([ExtResource("9_lod0"), ExtResource("10_lod1"), ExtResource("11_lod2")])

[node name="PickableHighlight" type="Node3D" parent="."]
script = ExtResource("5_pickhigh")

; The platter TURNS, on the model's spin axis. The model's Platter (and its spindle and
; RecordSeat) of every level is hung under it at _ready. The seated record is turned
; alongside it from the same angular velocity rather than being parented to it — see
; MediaSlot below for why.
[node name="Platter" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.055, 0.061, 0)

; A DIRECT child of the deck, named exactly this: RetroAudioPlayer resolves it as
; $MediaSlot. It deliberately does NOT ride the platter — a seated record is spun
; by the deck instead, the way the CD player spins a disc, so that this node stays
; where the base and the net layer expect to find it. On the mat (the model's
; RecordSeat, y 0.083) plus half a record.
[node name="MediaSlot" parent="." instance=ExtResource("2_snapzone")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.055, 0.0839, 0)
grab_distance = 0.12
snap_require = "vinyl_record"

[node name="SnapHighlight" type="Node3D" parent="MediaSlot"]
script = ExtResource("4_snaphis")

[node name="HighlightMesh" type="MeshInstance3D" parent="MediaSlot/SnapHighlight"]
mesh = SubResource("Cyl_record_ghost")
surface_material_override/0 = SubResource("Mat_record_ghost")

; Where a fingertip is tested against the record. Does NOT ride the platter — it is
; the fixed frame the hand's angle is measured in, and spinning it would cancel out
; exactly the rotation being measured.
[node name="PlatterPoke" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.055, 0.085, 0)
collision_layer = 0
collision_mask = 0

; ARM MOUNT, on the model's bearing axis (x 0.135, z -0.1; the bearing base's top).
; Its basis is the whole trick: VRHinge writes target.rotation.x and measures the hand
; in the pivot's own rest frame, so a tonearm — which swings about VERTICAL — needs a
; frame whose local X points along the deck's up axis. That is R_z(+90) composed with
; a half turn: local X -> +Y, and the arm's deg-0 direction (local -Z) -> the front.
; Listed by ROWS here, as .tscn always does.
;
; The model's ArmPivot (tube, headshell, counterweight) of every level is hung under
; the pivot at _ready, so the lever turns the model's own arm. Its angles: the arm at
; rest points 3.739 deg right of the front; the lead-in groove (146 mm) is -24.161 and
; the run-out (60 mm) -47.261, from the model's yaws (contract) plus a half turn. With
; the throw 3.739..-47.261 (51 deg) the lever's values are: rest 0, the record's edge
; (152 mm, -22.45 deg) 0.5135 = arm_park, lead-in 0.5471, run-out 1.0.
[node name="ArmMount" type="Node3D" parent="."]
transform = Transform3D(0, 1, 0, 1, 0, 0, 0, 0, -1, 0.135, 0.066, -0.1)

; At rest: 3.739 deg about local X (the deck's up).
[node name="ArmPivot" type="Node3D" parent="ArmMount"]
transform = Transform3D(1, 0, 0, 0, 0.997871, -0.065212, 0, 0.065212, 0.997871, 0, 0, 0)

; The lever sits ON the headshell's finger lift, not at the pivot: VRHinge measures
; tip proximity from its own origin. 30 mm up (local X) and 225 mm out along the arm
; (local -Z); the stylus is at 230. Child of the pivot, so it rides the arm round.
[node name="TonearmLever" type="Area3D" parent="ArmMount/ArmPivot" node_paths=PackedStringArray("target")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.03, 0, -0.225)
collision_layer = 0
collision_mask = 0
script = ExtResource("6_vrlever")
target = NodePath("..")
min_deg = -47.261
max_deg = 3.739
engage_radius = 0.05
value_at_min = 1.0
value_at_max = 0.0

[node name="CollisionShape3D" type="CollisionShape3D" parent="ArmMount/ArmPivot/TonearmLever"]
shape = SubResource("Shape_armgrab")

; The model carries its own arm rest; this node is kept (hidden) for anything that
; still looks it up by name.
[node name="ArmRest" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.185, 0.06, 0.085)
visible = false

; THE DUST COVER, hinged along its back edge (the model's hinge axis, y 0.061,
; z -0.197). The model's DustCover of every level is hung under CoverPivot at _ready;
; the lever on its front lip turns it about local X: negative lifts the front.
; Authored OPEN (-80 deg, value 1): a fresh deck takes a record. A VRLever, so the room
; save (articulated controls, by path) and netplay carry it like the tonearm.
[node name="CoverPivot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.173648, 0.984808, 0, -0.984808, 0.173648, 0, 0.061, -0.197)

[node name="CoverLever" type="Area3D" parent="CoverPivot" node_paths=PackedStringArray("target")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.015, 0.392)
collision_layer = 0
collision_mask = 0
script = ExtResource("6_vrlever")
target = NodePath("..")
min_deg = -80.0
max_deg = 0.0
engage_radius = 0.06
value_at_min = 1.0
value_at_max = 0.0

[node name="CollisionShape3D" type="CollisionShape3D" parent="CoverPivot/CoverLever"]
shape = SubResource("Shape_coverlip")

; The status line: flat on the deck plate's front strip, between the platter and the
; front edge (the model carries the brand on its own front band).
; The status line (what is playing) stands on the front band's free middle, between START-STOP and the
; print, upright like the band's lettering; lying on the deck plate it read as a stray sticker.
[node name="NameLabel" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.01, 0.024, 0.2008)
pixel_size = 0.0008
modulate = Color(0.85, 0.87, 0.9, 1)
text = "RECORD PLAYER"
font_size = 10
outline_size = 2

