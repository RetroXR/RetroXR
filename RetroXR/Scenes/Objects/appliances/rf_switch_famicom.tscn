; ── HVC-003 RF Switch (Famicom) ─────────────────────────────────────────────────
;
; FamicomRfSwitch, an RfSwitch: the RXR-003's layout (rf_switch.tscn) in a small
; white box. PlugA0 the console lead's black phono plug, PlugB0 the TV lead's F
; plug (the real lead is bare coax for screw terminals; the game's sets take F),
; AntPort the aerial's input on the coax screw terminal, standing UP out of the top.
; The deck rope is named VerletRope for CompositeCable's sake (see rf_switch.tscn).
;
; ── The frame ───────────────────────────────────────────────────────────────────
; Body IS RetroXR-models' glTF frame for nintendo/famicom/rf-switch (meters, +Y up,
; base on y = 0, centered in X and Z): a mod puts the GLB on Body UNTRANSFORMED,
; hides Body/Shell (every stand-in mesh) and sets Body/AntPort's show_jack false if
; the model moulds its terminal. Box 82.6 (X) x 15.5 (Y) x 61.3 (Z) on a lip.
; Markers on the model's empties:
;   DeckLeadAttach  DeckCordAnchor ( 0.0425, 0.0062, -0.0040), lead out along +X
;   TvLeadAttach    TVCordAnchor   ( 0.0159, 0.0062, -0.03185), lead out along -Z
;   AntPort         AntennaAnchor  (-0.0183, 0.0191,  0.0084), the coax terminal's
;                   cap top; the zone's +Z is +Y, so an F plug arrives from above
;                   and seats moving -Y
[node name="FamicomRfSwitch" type="Node3D"]
script = ExtResource("1_switchscript")
cord_colors = PackedColorArray(0.07, 0.07, 0.08, 1)

[node name="Body" type="RigidBody3D" parent="."]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_switch")
mass = 0.06
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_bodyscript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body"]
