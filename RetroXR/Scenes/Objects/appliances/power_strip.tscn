; ── PowerStrip: six NEMA 5-15R sockets and a captive 3 ft cord ─────────────────
;
; A lead with a body on one end, like the Antenna: the Body is what the player
; carries, the root never moves (hence carried_body_pose). The cord leaves the SWITCH
; end, from the GLB's CordAnchor, whose local -Z points out of the end face.
[node name="PowerStrip" type="Node3D"]
script = ExtResource("1_strip")

; 290 x 38 x 52 mm, origin on the floor under its centre; outlets face +Y.
[node name="Body" type="RigidBody3D" parent="."]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("Phys_strip")
mass = 0.4
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_body")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.019, 0)
shape = SubResource("Shape_body")

[node name="Shell" parent="Body" instance=ExtResource("3_shell")]

[node name="PointerArea" type="StaticBody3D" parent="Body"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body/PointerArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.019, 0)
shape = SubResource("Shape_bodyptr")

[node name="PickableHighlight" type="Node3D" parent="Body"]
script = ExtResource("7_highlight")

; The sockets. A PowerPort faces its local +Z with the outlet's "up" (away from the
; ground hole) on local +Y, as on the bedroom wall outlets. Here +Z is world up and
; the ground holes are toward -X, so local +Y is +X: basis columns x=(0,0,1),
; y=(1,0,0), z=(0,1,0). Named Socket1..6 from the far end: a save names a socket by
; node name, so these must not be renamed.

[node name="Socket1" parent="Body" instance=ExtResource("4_port")]
transform = Transform3D(0, 1, 0, 0, 0, 1, 1, 0, 0, -0.11, 0.036, 0)
accepted_plug = "nema_5_15_plug"

[node name="Socket2" parent="Body" instance=ExtResource("4_port")]
transform = Transform3D(0, 1, 0, 0, 0, 1, 1, 0, 0, -0.074, 0.036, 0)
accepted_plug = "nema_5_15_plug"

[node name="Socket3" parent="Body" instance=ExtResource("4_port")]
