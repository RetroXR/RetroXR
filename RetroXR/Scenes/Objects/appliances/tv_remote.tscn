; The RETRO XR remote (RetroXR-models generic/tv-remote): 50 x 22.5 x 175 mm, keys up (+Y),
; the infrared window along -Z, 100 mm ahead of the origin (the grip end 75 mm behind it). Both shapes are replaced in _ready by what the model draws
; (TVRemote._fit_shapes): a convex hull of the shell for the body, the shell's own triangles
; for the laser. These boxes are the shell's bounds, for the editor.
[sub_resource type="BoxShape3D" id="BoxShape3D_remote"]
size = Vector3(0.05, 0.0225, 0.175)

[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.05, 0.0225, 0.175)

[sub_resource type="PhysicsMaterial" id="PhysMat_remote"]
bounce = 0.0
friction = 0.8

[node name="TVRemote" type="RigidBody3D" groups=["hand_held_device"]]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_remote")
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("1_remotescript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.0001, 0)
shape = SubResource("BoxShape3D_remote")

; LOD0 inside 1 m (a fingertip only presses within 0.35 m), LOD1 to 2.5 m.
[node name="Model" type="Node3D" parent="."]
script = ExtResource("6_model")
level_scenes = Array[PackedScene]([ExtResource("7_lod0"), ExtResource("8_lod1"), ExtResource("9_lod2")])
switch_distance = 1.0
far_distance = 2.5
hysteresis = 0.1

; One VRButton per key, built from the model's 26 keys (TVRemote._dress_keys).
[node name="Keys" type="Node3D" parent="."]

; Put on the model's IrTip in _ready: the middle of the window's end face, aiming along -Z.
[node name="Tip" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.003, -0.1)

; Under the battery end, where a hand closes round a remote with the thumb on the keys.
[node name="GrabPoint" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.012, 0.055)
visible = false
script = ExtResource("3_grabpoint")

[node name="PickableHighlight" type="Node3D" parent="."]
script = ExtResource("2_pickhigh")

[node name="PointerArea" type="StaticBody3D" parent="."]
collision_layer = 1048576
