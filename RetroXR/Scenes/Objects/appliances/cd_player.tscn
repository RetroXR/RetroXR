channel = 2
direction = 0

; PHONES: a 3.5 mm stereo jack on the front (a TrsPort, OUT). Headphones in it take the disc's sound (audio_player.gd,
; "PHONES"); seated on the model's PhonesOut mouth at _ready.
[node name="PhonesOut" parent="." instance=ExtResource("14_trsport")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.166, -0.017, 0.146)
direction = 0

