; The line out on the model's back (white L, red R): a lead into a set's audio input or the surround amplifier's
; AUDIO IN carries the disc there (audio_player.gd, "Line out"). Seated on the model's jack mouths at _ready.
[node name="AudioLOut" parent="." instance=ExtResource("10_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.1, 0, -0.154)
channel = 1
direction = 0

[node name="AudioROut" parent="." instance=ExtResource("10_rcaport")]
