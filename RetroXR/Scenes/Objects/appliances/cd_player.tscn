[sub_resource type="PhysicsMaterial" id="PhysMat_cd"]
friction = 0.8

; Fitted to the model at _ready (ApplianceModel.fit_shapes): what is drawn, less the tray.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.43, 0.095, 0.29)

; The ghost a held disc shows on the open tray. The zone itself is put on the tray's DiscSeat at _ready.
[sub_resource type="CylinderMesh" id="Cyl_disc_ghost"]
top_radius = 0.06
bottom_radius = 0.06
height = 0.0015

[sub_resource type="StandardMaterial3D" id="Mat_disc_ghost"]
transparency = 1
albedo_color = Color(0.2, 0.5, 1, 0.4)
emission_enabled = true
emission = Color(0, 0.15, 0.5, 1)
emission_energy_multiplier = 0.4

; Placeholder boxes; ApplianceModel.adopt_button() replaces each key's with the model's own key and fits the box to it.
[sub_resource type="BoxShape3D" id="BoxShape3D_btn"]
size = Vector3(0.03, 0.02, 0.03)

; The LEVEL knob's box; cd_player.gd fits it to the model's knob.
[sub_resource type="BoxShape3D" id="Shape_level"]
size = Vector3(0.017, 0.017, 0.009)

[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.43, 0.095, 0.29)

; RETRO XR CD player (RetroXR-models generic/cd-player): its three levels under Model, dressed by cd_player.gd (the
; tray is a DeckDrawer, the keys the model's, the display a VfdDisplay).
[node name="CDPlayer" type="RigidBody3D" groups=["cd_player"]]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_cd")
freeze_mode = 1
linear_damp = 5.0
angular_damp = 8.0
script = ExtResource("1_cdscript")
player_label = "CD PLAYER"

