; A small 90s multimedia speaker: 85 W x 145 H x 85 D mm. Origin at the base centre,
; so a cabinet set on a desk stands on it rather than sinking in.
[sub_resource type="BoxMesh" id="Mesh_cabinet"]
size = Vector3(0.085, 0.145, 0.085)

; The front baffle stands 2 mm proud so its edge catches light — the same trick the
; tower's bezel and the wardrobe's door panels use.
[sub_resource type="BoxMesh" id="Mesh_baffle"]
size = Vector3(0.087, 0.147, 0.004)

; CylinderMesh runs along its own Y, so every driver and port below rotates +90
; about X to lie along Z and face out of the baffle. Written transposed, as .tscn
; stores it: args are [x.x, y.x, z.x, x.y, y.y, z.y, x.z, y.z, z.z], so y maps to +Z.
[sub_resource type="CylinderMesh" id="Mesh_cone"]
top_radius = 0.026
bottom_radius = 0.026
height = 0.006

[sub_resource type="CylinderMesh" id="Mesh_dustcap"]
top_radius = 0.009
bottom_radius = 0.009
height = 0.005

[sub_resource type="CylinderMesh" id="Mesh_port"]
top_radius = 0.007
bottom_radius = 0.007
height = 0.006

; The pointer bar on the cap face, sized in metres directly — reusing the cap mesh
; with a scaled transform made a 0.03 mm speck, because those factors multiply an
; already-11 mm cylinder rather than replacing its size.
[sub_resource type="BoxMesh" id="Mesh_knobmark"]
size = Vector3(0.0018, 0.006, 0.0012)

[sub_resource type="CylinderMesh" id="Mesh_knobcap"]
top_radius = 0.011
bottom_radius = 0.012
height = 0.009

; Beige, and grubby-warm rather than clean grey — lifted from pc_tower.tscn so the
; set reads as the one that came with the machine.
[sub_resource type="StandardMaterial3D" id="Mat_beige"]
albedo_color = Color(0.77, 0.73, 0.63, 1)
roughness = 0.62

[sub_resource type="StandardMaterial3D" id="Mat_baffle"]
albedo_color = Color(0.72, 0.68, 0.59, 1)
roughness = 0.7

[sub_resource type="StandardMaterial3D" id="Mat_cone"]
albedo_color = Color(0.09, 0.09, 0.10, 1)
roughness = 0.75

; A bass port is a hole. Dark by MATERIAL, not by depth: these rooms light with a
; flat ambient colour and no radiance map, so a recess given the cabinet's own
; material renders exactly as bright as the panel around it.
[sub_resource type="StandardMaterial3D" id="Mat_hole"]
albedo_color = Color(0.03, 0.03, 0.035, 1)
roughness = 0.6

[sub_resource type="StandardMaterial3D" id="Mat_knob"]
albedo_color = Color(0.16, 0.16, 0.17, 1)
roughness = 0.42

[sub_resource type="StandardMaterial3D" id="Mat_knobmark"]
albedo_color = Color(0.88, 0.86, 0.80, 1)
roughness = 0.5

[sub_resource type="PhysicsMaterial" id="PhysMat_box"]
bounce = 0.0
friction = 0.8

[sub_resource type="BoxShape3D" id="Shape_box"]
size = Vector3(0.085, 0.145, 0.085)

; Laser target, one size up from the body. Only the pointer answers this shape
; (mask 0), so nothing else notices it is generous.
[sub_resource type="BoxShape3D" id="Shape_pointer"]
size = Vector3(0.105, 0.165, 0.105)

[sub_resource type="BoxShape3D" id="Shape_knob"]
size = Vector3(0.026, 0.026, 0.014)

; Two cabinets and the wire between them. A plain Node3D holder, exactly as
; composite_cable.tscn holds two independently grabbable plugs and a rope: each box
; is its own RigidBody3D, so either can be picked up and set down on its own and the
; wire simply limits how far apart they get.
;
; Only the RIGHT box is powered — it carries the line-in socket and the volume knob,
; which is where a real pair puts them. The left is a passive cabinet.
[node name="SpeakerPair" type="Node3D"]
script = ExtResource("1_pairscript")

; ── LEFT ─────────────────────────────────────────────────────────────────────
[node name="SpeakerL" type="RigidBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.25, 0, 0)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_box")
mass = 0.6
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("5_speakerbox")

[node name="CollisionShape3D" type="CollisionShape3D" parent="SpeakerL"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0725, 0)
shape = SubResource("Shape_box")

[node name="Cabinet" type="MeshInstance3D" parent="SpeakerL"]
