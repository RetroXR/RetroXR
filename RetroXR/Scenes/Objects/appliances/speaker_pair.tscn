; What get_speaker_positions() publishes — the cone face, not the box origin, so the
; sound comes from where the driver is.
[node name="ConeFront" type="Marker3D" parent="SpeakerL"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.095, 0.048)

; Where the wire leaves the cabinet.
[node name="CableBoss" type="Marker3D" parent="SpeakerL"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.025, 0.028, -0.0425)

; Turned 180 about Y so it reads the right way round from BEHIND the cabinet.
; pixel_size 0.001 with font_size 8 is 8 mm of text, the project's size for a word
; printed on a face (see cassette_player.tscn's button labels).
;
; outline_size 0 matters at this size. Label3D outlines by default, and dark text
; with a dark outline on a beige panel fuses into an unreadable blob — the outline
; is there to lift a floating billboard off a busy background, which is the opposite
; of a word printed flat on a cabinet.
[node name="BackLabel" type="Label3D" parent="SpeakerL"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0.115, -0.0432)
pixel_size = 0.001
text = "LEFT"
font_size = 8
outline_size = 0
modulate = Color(0.2, 0.18, 0.15, 1)

[node name="PickableHighlight" type="Node3D" parent="SpeakerL"]
script = ExtResource("2_pickhigh")

