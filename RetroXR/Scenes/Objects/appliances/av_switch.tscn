; The RETRO XR AV selector (RetroXR-models generic/av-switch): 280 W x 42 H x 120 D mm, feet included. Origin at the
; BASE centre; the front (+Z) carries the four-position slide under four label windows, the back (-Z) every jack:
; INPUT 1-4 (yellow, white, red), TO TV, DC IN. The model's own origin is the middle of its box, 21 mm up: `Model`
; carries that offset.
;
; The scene keeps the nodes the engine works through and AvSwitch._dress places them from the model: every RcaPort
; on its jack's mouth (show_jack off; the model moulds the jacks), the slide on the model's tab (its box fitted to
; the tab exactly), the DC IN built in code on the model's DcIn. The transforms below are only where they start.
; Node names are saved and sent: never rename one.

[sub_resource type="PhysicsMaterial" id="PhysMat_box"]
bounce = 0.0
friction = 0.8

; Refitted by ApplianceModel.fit_shapes to what the model draws.
[sub_resource type="BoxShape3D" id="Shape_box"]
size = Vector3(0.28, 0.042, 0.12)

; Refitted to the tab exactly (AvSwitch._dress_slide).
[sub_resource type="BoxShape3D" id="Shape_tab"]
size = Vector3(0.016, 0.009, 0.004)

; Laser target: refitted exactly too. Only the pointer answers this shape (mask 0).
[sub_resource type="BoxShape3D" id="Shape_pointer"]
size = Vector3(0.28, 0.042, 0.12)

[node name="AvSwitch" type="RigidBody3D"]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_box")
mass = 0.6
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("1_avs")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.021, 0)
shape = SubResource("Shape_box")

; Before PickableHighlight: the highlight traces the model's meshes when it is ready.
[node name="Model" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.021, 0)
script = ExtResource("5_model")
level_scenes = Array[PackedScene]([ExtResource("6_lod0"), ExtResource("7_lod1"), ExtResource("8_lod2")])

; The slide: four detents 32 mm apart along +X (INPUT 1 at value 0). Moved onto the model's tab in code; the hand,
; the laser, the desktop ray and a fingertip all take the tab itself. Saved and synced as every slider is.
[node name="Selector" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.038, 0.0175, 0.066)
collision_layer = 1048576
collision_mask = 0
script = ExtResource("4_slider")
travel = 0.096
steps = 4
engage_radius = 0.02

[node name="CollisionShape3D" type="CollisionShape3D" parent="Selector"]
shape = SubResource("Shape_tab")

; -- Back --
; Rx(180) turns a socket's +Z out of the back. direction 1 is IN, 0 is OUT; channel 0 video, 1 left, 2 right.

