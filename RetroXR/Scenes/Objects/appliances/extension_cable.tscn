; ── ExtensionCable: a one-outlet head on a cord, a wall plug at the far end ───
;
; A PowerStrip with one socket (extension_cable.gd). The Body is the head; its
; mesh, shapes, socket and CordAnchor are set by set_region from head_of.
[node name="ExtensionCable" type="Node3D"]
script = ExtResource("1_strip")

; Origin on the floor under the head; the socket faces +Y.
[node name="Body" type="RigidBody3D" parent="."]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("Phys_strip")
mass = 0.15
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_body")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.019, 0)
shape = SubResource("Shape_body")

[node name="Head" type="MeshInstance3D" parent="Body"]

[node name="CordAnchor" type="Node3D" parent="Body"]

[node name="PointerArea" type="StaticBody3D" parent="Body"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body/PointerArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.019, 0)
shape = SubResource("Shape_bodyptr")

[node name="PickableHighlight" type="Node3D" parent="Body"]
script = ExtResource("7_highlight")

[node name="Socket1" parent="Body" instance=ExtResource("4_port")]
transform = Transform3D(0, 1, 0, 0, 0, 1, 1, 0, 0, -0.11, 0.036, 0)
connector = "nema_5_15_plug"

; ── the wall plug ─────────────────────────────────────────────────────────────
; PowerCord's WallPlug, with the body baked in the case colour
; (DevTools/gen/ivory_plug.gd). Turned R_y(+90) so its cord (plug-local -Z) trails
; back toward the strip's switch end.
[node name="WallPlug" type="RigidBody3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 0.55, 0.021, 0)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("Phys_plug")
mass = 0.085
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("5_plug")
connector = "nema_5_15_plug"

[node name="CollisionShape3D" type="CollisionShape3D" parent="WallPlug"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.0167)
shape = SubResource("Shape_nema")

[node name="PlugTip" type="MeshInstance3D" parent="WallPlug"]
mesh = ExtResource("6_nema")

[node name="PointerArea" type="StaticBody3D" parent="WallPlug"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="WallPlug/PointerArea"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.019)
shape = SubResource("Shape_pointer")

[node name="PickableHighlight" type="Node3D" parent="WallPlug"]
script = ExtResource("7_highlight")

[node name="SnapGrabPoint" parent="WallPlug" instance=ExtResource("8_grab")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)

; ── the cord ──────────────────────────────────────────────────────────────────
; 150 x 40 mm = 6 m, the longest the menu offers; a shorter cable drops
; segments in _ready (never adds them: CompositeCable._apply_cord_length).
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 150
segment_length = 0.04
constraint_iterations = 8
bend_stiffness = 0.22
tube_radius = 0.00425
tube_sides = 8
smoothing = 2
rope_color = Color(0.906, 0.901, 0.876, 1)
surface_collision_mask = 7
collision_radius = 0.0056
self_collision = true
end_align_stiffness = 0.72
end_stiffness = 0.48
end_stiff_segments = 2
