; A surround amplifier of the Pro Logic II years: 430 W x 150 H x 340 D mm, the
; size of the receivers it stands in for (a Harman DCR 600 II is 440 x 165 x 435).
; Origin at the BASE centre, so it stands on a shelf by being placed on it; the
; front is +Z and the back panel -Z, as on the television.
;
; Primitive, and laid out as those units were: a display window across the middle
; of the face, the mode key under it, the volume knob on the right. No power key —
; there is no power state to model, and a key that does nothing is a lie.

[sub_resource type="PhysicsMaterial" id="PhysMat_box"]
bounce = 0.0
friction = 0.8

; The sheet-metal cover: everything but the front 12 mm.
[sub_resource type="BoxMesh" id="Mesh_chassis"]
size = Vector3(0.43, 0.135, 0.328)

[sub_resource type="BoxMesh" id="Mesh_fascia"]
size = Vector3(0.43, 0.135, 0.012)

; The display window, 2 mm proud of the fascia so its edge catches light.
[sub_resource type="BoxMesh" id="Mesh_window"]
size = Vector3(0.17, 0.042, 0.002)

