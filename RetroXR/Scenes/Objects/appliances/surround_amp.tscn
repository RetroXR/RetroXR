; ── Back ─────────────────────────────────────────────────────────────────────
; The cover's back face is z = -0.170, and every socket's zone sits 10 mm proud of
; it, as rca_port.tscn expects. Rx(180) turns a socket's +Z out of the back — the
; television's SPEAKERS row, copied basis and all, at the same 18 mm pitch.
;
; Seen from behind, device +X is on the viewer's LEFT, so the descending x below
; reads AUDIO IN L R, then FL FR C SUB SL SR, left to right. AvLegend sorts on that.

; AUDIO IN — the line input. direction = 1 is IN.
[node name="AudioInL" parent="." instance=ExtResource("3_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.16, 0.1, -0.18002)
channel = 1
direction = 1

[node name="AudioInR" parent="." instance=ExtResource("3_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.142, 0.1, -0.18002)
channel = 2
direction = 1

; SPEAKERS — what a loudspeaker cabinet is cabled to. direction = 0 is OUT, and the
; channels are the appended surround values: 1 L, 2 R, 4 CENTER, 5 SUB, 6 SL, 7 SR.
[node name="SpeakerOutL" parent="." instance=ExtResource("3_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.07, 0.1, -0.18002)
channel = 1
direction = 0

