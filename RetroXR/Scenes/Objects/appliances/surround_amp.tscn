; VOLUME, on the right as seen from the front (+X).
;
; KnobPivot's local Z already points out of the face, which is what VRKnob turns
; about. The cap MESH is the pivot's child and carries the +90-about-X that lays a
; Y-aligned CylinderMesh along that axle, set 10 mm out so its back face meets the
; fascia.
[node name="VolumeKnob" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.15, 0.09, 0.17)
collision_layer = 1048576
collision_mask = 0
script = ExtResource("5_vrknob")
engage_radius = 0.05
value = 0.75

