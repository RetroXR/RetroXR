; The RETRO XR surround receiver (RetroXR-models generic/surround-receiver): 430 W x
; 115 H x 340 D mm. Origin at the BASE centre, so it stands on a shelf by being placed
; on it; the front is +Z and the back panel -Z, as on the television. The model's own
; origin is the centre of its box, 57.5 mm up: `Model` carries that offset.
;
; The model is the whole look: the vented cover, the SURROUND MODE key, the VOLUME knob,
; the smoked window, the legends front and back and the coloured jacks. The scene keeps
; the nodes the engine works through and dresses them from it (SurroundAmp._dress): the
; key's mesh goes into ModeButton, the knob hangs under KnobPivot, a VfdDisplay sits on
; the model's Display, and every RcaPort sits on its jack's mouth with its own jack off.
; No power key — there is no power state to model, and a key that does nothing is a lie.

[sub_resource type="PhysicsMaterial" id="PhysMat_box"]
bounce = 0.0
friction = 0.8

; Sized again from the model's key by ApplianceModel.adopt_button.
[sub_resource type="BoxShape3D" id="Shape_btn"]
size = Vector3(0.03, 0.012, 0.008)

; The 52 mm knob, 20 mm deep from the face: what a hand closes on.
[sub_resource type="BoxShape3D" id="Shape_knob"]
size = Vector3(0.06, 0.06, 0.03)

[sub_resource type="BoxShape3D" id="Shape_box"]
size = Vector3(0.43, 0.115, 0.34)

; Laser target, one size up. Only the pointer answers this shape (mask 0).
[sub_resource type="BoxShape3D" id="Shape_pointer"]
size = Vector3(0.45, 0.135, 0.36)

[node name="SurroundAmp" type="RigidBody3D"]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_box")
mass = 4.0
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("1_amp")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0575, 0)
shape = SubResource("Shape_box")

; Before PickableHighlight: the highlight traces the model's meshes when it is ready.
[node name="Model" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.0575, 0)
script = ExtResource("6_model")
level_scenes = Array[PackedScene]([ExtResource("7_lod0"), ExtResource("8_lod1"), ExtResource("9_lod2")])

; ── Front ────────────────────────────────────────────────────────────────────
; The fascia's face is z = 0.170.

; What the decoder is switched to. Hidden: the VfdDisplay on the model's window draws it
; (SurroundAmp._paint_vfd). Kept carrying the decoder's name, which the tests read.
[node name="DisplayText" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.076, 0.1725)
visible = false
pixel_size = 0.0002
text = "PRO LOGIC II"
font_size = 64
outline_size = 0
modulate = Color(0.42, 0.95, 0.88, 1)

; SURROUND MODE, under the window. Moved onto the model's key by adopt_button, which
; also turns its press along -Z, into the face.
[node name="ModeButton" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.055, 0.0405, 0.17)
collision_layer = 0
collision_mask = 0
script = ExtResource("4_vrbutton")

[node name="CollisionShape3D" type="CollisionShape3D" parent="ModeButton"]
shape = SubResource("Shape_btn")

[node name="ButtonMesh" type="MeshInstance3D" parent="ModeButton"]

; VOLUME, on the right as seen from the front (+X), on the model knob's axle (65.5 mm
; up). KnobPivot's local Z points out of the face, which is what VRKnob turns about;
; the model's knob hangs under it (ApplianceModel.attach_part), its dot at 12 o'clock
; at mid-travel — VRKnob's 135 .. -135 degrees, the model's own sweep.
[node name="VolumeKnob" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.15, 0.0655, 0.17)
collision_layer = 1048576
collision_mask = 0
script = ExtResource("5_vrknob")
engage_radius = 0.05
value = 0.75

[node name="CollisionShape3D" type="CollisionShape3D" parent="VolumeKnob"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.01)
shape = SubResource("Shape_knob")

[node name="KnobPivot" type="Node3D" parent="VolumeKnob"]

; ── Back ─────────────────────────────────────────────────────────────────────
; The cover's back face is z = -0.170; each socket's zone sits on the mouth of the
; model's jack, 9 mm out, 62.5 mm up (the model is 115 mm tall; the 150 mm primitive
; had them at 100 mm). show_jack is off: the model moulds the jacks, in the 5.1 colours.
; Rx(180) turns a socket's +Z out of the back — the television's SPEAKERS row, at the
; same 18 mm pitch.
;
; Seen from behind, device +X is on the viewer's LEFT, so the descending x below
; reads AUDIO IN L R, then FL FR C SUB SL SR, left to right. AvLegend sorts on that.

; AUDIO IN — the line input. direction = 1 is IN.
[node name="AudioInL" parent="." instance=ExtResource("3_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.16, 0.0625, -0.179)
channel = 1
direction = 1
show_jack = false

[node name="AudioInR" parent="." instance=ExtResource("3_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.142, 0.0625, -0.179)
channel = 2
direction = 1
show_jack = false

; SPEAKERS — what a loudspeaker cabinet is cabled to. direction = 0 is OUT, and the
; channels are the appended surround values: 1 L, 2 R, 4 CENTER, 5 SUB, 6 SL, 7 SR.
