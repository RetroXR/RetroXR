; Fitted to the connector mesh (measured by Tools/rope/plug_shape_probe), so a
; loose plug lies ON a surface at its real size. It was a sphere two to five
; times the plug's thickness, which rolled under any push and held the plug
; centimetres off the floor with nothing visibly holding it there.
[sub_resource type="BoxShape3D" id="BoxShape3D_plugfit"]
size = Vector3(0.0144, 0.0144, 0.054)

[sub_resource type="BoxShape3D" id="BoxShape3D_plugfit2"]
size = Vector3(0.0128, 0.0111, 0.0444)

[sub_resource type="SphereShape3D" id="SphereShape3D_pointer"]
radius = 0.038

; ── RXR-003 RF Switch ─────────────────────────────────────────────────────────
;
; A lead with a box in the middle. The root is a CompositeCable (see rf_switch.gd
; for why), so the two connectors MUST stay named PlugA0 and PlugB0 — that is what
; _count_cords reads, and renaming either one makes the switch carry nothing.
;
; PlugA0 is the CONTROL DECK end, the black phono plug on the long lead.
; PlugB0 is the TV end, the male F connector on the short coax pigtail.
;
; The deck rope is named "VerletRope" and not "DeckRope" because CompositeCable
; resolves $VerletRope in an @onready; the name is the base class's, not a
; description. The pigtail is TvRope and the base never looks for it.
[node name="RfSwitch" type="Node3D"]
script = ExtResource("1_switchscript")

; ── the box ───────────────────────────────────────────────────────────────────
; 90 x 20 x 50 mm, origin at its centre. Faces: -X is TV, +X is ANT, -Z is
; CONTROL DECK — the arrangement the mouldings label.
[node name="Body" type="RigidBody3D" parent="."]
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_switch")
mass = 0.08
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("2_bodyscript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body"]
shape = SubResource("BoxShape3D_body")

[node name="Shell" type="MeshInstance3D" parent="Body"]
mesh = ExtResource("3_shell")

; Laser target, deliberately larger than the case so a small grey box can be hit
; with a beam from across the room. Answers the pointer only (mask 0).
[node name="PointerArea" type="StaticBody3D" parent="Body"]
collision_layer = 1048576
collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="Body/PointerArea"]
shape = SubResource("BoxShape3D_bodyptr")

[node name="PickableHighlight" type="Node3D" parent="Body"]
script = ExtResource("8_pickhigh")

; ── the printed top face ──────────────────────────────────────────────────────
; Rx(-90) lays a Label3D flat facing +Y with its reading direction along +X and its
; top toward -Z. Sat 0.2 mm above the shell; alpha_cut = 1 (discard) so the glyphs
; depth-write instead of sorting as transparency against the case under them.
[node name="LabelDeck" type="Label3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, -4.371139e-08, 1, 0, -1, -4.371139e-08, 0.019, 0.0102, -0.0185)
