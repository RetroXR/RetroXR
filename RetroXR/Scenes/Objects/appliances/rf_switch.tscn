; ── the ropes ─────────────────────────────────────────────────────────────────
; The long CONTROL DECK lead: 50 x 36 mm = 1.80 m, the coil in the reference photos.
[node name="VerletRope" type="VerletRope" parent="."]
segment_count = 50
segment_length = 0.036
constraint_iterations = 8
bend_stiffness = 0.2
tube_radius = 0.0022
tube_sides = 6
smoothing = 2
rope_color = Color(0.07, 0.07, 0.08, 1)
surface_collision_mask = 7
collision_radius = 0.0045
self_collision = true
end_align_stiffness = 0.7
end_stiffness = 0.45
end_stiff_segments = 2

; The TV pigtail: 10 x 25 mm = 0.25 m, and STIFF. bend_stiffness 0.5 against the
; deck lead's 0.2 is what makes it hold the standing arc it has in every photo of
; one of these rather than flopping like the long lead.
[node name="TvRope" type="VerletRope" parent="."]
