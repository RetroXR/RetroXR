; ── the ANT socket ────────────────────────────────────────────────────────────
; Yawed 90 so the socket receives along +X, the way nes_model.gd turns the jacks on
; its own +X flank. 55 mm out, not 45: the zone sits where a seated plug's ORIGIN
; belongs, which is the 10 mm standoff clear of the 45 mm case wall, and the jack is
; pushed back by that much so its flange lands on the wall.
[node name="AntPort" parent="Body" instance=ExtResource("10_coaxport")]
transform = Transform3D(-4.371139e-08, 0, 1, 0, 1, 0, -1, 0, -4.371139e-08, 0.055, 0, 0)
direction = 1

; ── where the two leads leave ─────────────────────────────────────────────────
; A VerletRope leaves its anchor along the anchor's LOCAL -Z, which is the opposite
; convention to a port's +Z. So the deck lead's marker is unturned to send its rope
; out -Z, and the TV pigtail's is yawed 90 to send its rope out -X.
[node name="DeckLeadAttach" type="Marker3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.012, 0, -0.025)

[node name="TvLeadAttach" type="Marker3D" parent="Body"]
transform = Transform3D(-4.371139e-08, 0, 1, 0, 1, 0, -1, 0, -4.371139e-08, -0.045, 0, 0)

; ── End A: the CONTROL DECK plug ──────────────────────────────────────────────
; Turned about Y so its cord trails back toward the box: the plug mesh is authored
; connector-on-+Z with the cord leaving -Z, which is also VerletRope's
; plug_exit_axis, so an unturned plug here would leave its tail with a hairpin.
[node name="PlugA0" type="RigidBody3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0.012, 0, -0.25)
collision_layer = 4
collision_mask = 196613
physics_material_override = SubResource("PhysMat_switch")
mass = 0.05
linear_damp = 5.0
angular_damp = 8.0
freeze_mode = 1
script = ExtResource("4_rcaplugscript")

[node name="CollisionShape3D" type="CollisionShape3D" parent="PlugA0"]
