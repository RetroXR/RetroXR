; Fitted to the model at _ready (ApplianceModel.fit_shapes): what is drawn, less the door.
[sub_resource type="BoxShape3D" id="BoxShape3D_body"]
size = Vector3(0.43, 0.12, 0.3)

; The ghost a held cassette shows in the open door. The zone itself is put on the door's TapeSeat at _ready.
[sub_resource type="BoxMesh" id="BoxMesh_slot_ghost"]
size = Vector3(0.1004, 0.0638, 0.012)

[sub_resource type="StandardMaterial3D" id="Mat_slot_ghost"]
transparency = 1
albedo_color = Color(0.2, 0.5, 1, 0.35)
emission_enabled = true
emission = Color(0, 0.15, 0.5, 1)
emission_energy_multiplier = 0.4

; Placeholder boxes; ApplianceModel.adopt_button() replaces each key's with the model's own key and fits the box to it.
