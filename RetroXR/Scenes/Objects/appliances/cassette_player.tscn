size = Vector3(0.03, 0.02, 0.03)

[sub_resource type="BoxShape3D" id="BoxShape3D_pointer"]
size = Vector3(0.43, 0.12, 0.3)

; RETRO XR cassette deck (RetroXR-models generic/cassette-deck): its three levels under Model, dressed by
; cassette_player.gd (the door is a DeckDrawer, the keys the model's, the display a VfdDisplay).
[node name="CassettePlayer" type="RigidBody3D" groups=["cassette_player"]]
