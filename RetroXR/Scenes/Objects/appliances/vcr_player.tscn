; The old grey box, kept as a node (VCRBody is the housing a combo set hides, and a name the scripts know) but
; no longer drawn: the RETRO XR model below is the deck. See ApplianceModel and VCRPlayer._dress.
[node name="VCRBody" type="MeshInstance3D" parent="."]
visible = false
mesh = SubResource("BoxMesh_body")
surface_material_override/0 = SubResource("Mat_body")

; Before PickableHighlight, whose _ready outlines every mesh already under the deck.
[node name="Model" type="Node3D" parent="."]
script = ExtResource("9_model")
level_scenes = Array[PackedScene]([ExtResource("10_lod0"), ExtResource("11_lod1"), ExtResource("12_lod2")])

[node name="PickableHighlight" type="Node3D" parent="."]
script = ExtResource("5_pickhigh")

; At the model's door, where the holder takes a tape: TapeCarrier's rest pose, the tape's center 35 mm of
; spine out of the front. The tape lies flat as TapeSeat lays it (MediaSlot.media_local_basis).
[node name="TapeSlot" parent="." instance=ExtResource("2_snapzone")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.07, 0.011, 0.118)
grab_distance = 0.09
snap_require = "vcr_tape"

