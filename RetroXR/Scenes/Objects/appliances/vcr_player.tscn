channel = 1
direction = 0

[node name="AudioROut" parent="." instance=ExtResource("8_rcaport")]
transform = Transform3D(1, 0, 0, 0, -1, 8.742278e-08, 0, -8.742278e-08, -1, 0.118, 0, -0.145)
channel = 2
direction = 0

