; screen_size must match viewport_size's aspect (600:720) or pointer clicks land
; off-target, and it is authored here rather than set at runtime because the
; XRToolsViewport2DIn3D setter throws before it assigns.
;
; The page is raised by half of what its height adds over 0.32 m, so its bottom
; edge sits 0.16 m above the card and clears a console the card is seated in.
[node name="MemoryCardPanel" type="Node3D"]
script = ExtResource("1_panelscript")

[node name="MemoryCardViewport" parent="." instance=ExtResource("2_viewport2d3d")]
