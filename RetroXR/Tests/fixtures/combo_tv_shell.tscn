[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://Scripts/Objects/tv/tv_shell.gd" id="1_shell"]

; A TV/VCR/DVD combination cabinet, built from one box, for combo_tv_tests and
; Tools/av/combo_tv_probe. It is also the reference for a mod's own combination
; set: every marker a built-in deck reads is here, and nothing else is.
;
; Layout, in this shell's frame (the set's own): 0.76 x 0.62 x 0.36, centred on the
; origin, front face at z = +0.18.
;
;   x  -0.38 ............. +0.105 | +0.12 ........ +0.38
;      tube (0.35 x 0.25)          the set's own buttons
;      VCR  (slot, clock)          VCR's buttons
;      DVD  (tray)                 DVD's buttons
;
; Each deck's origin is the centre of the stock deck's body, whose front is 125 mm
; along its +Z: at z = 0.055 that front is flush with the cabinet's. The two
; control markers are R_x(+90) (rows 1,0,0, 0,0,-1, 0,1,0), which stands each
; deck's top-face button panel up on the front. ButtonRow, the set's own caps, is
; NOT turned: the caps keep their own facing and the row walks the marker's +X,
; wrapping down its -Y, so a turned marker sends the second row into the cabinet.

[sub_resource type="BoxMesh" id="Mesh_case"]
size = Vector3(0.76, 0.62, 0.36)

[sub_resource type="StandardMaterial3D" id="Mat_case"]
albedo_color = Color(0.16, 0.16, 0.17, 1)
roughness = 0.6

[node name="ComboTvShell" type="Node3D"]
script = ExtResource("1_shell")
body_size = Vector3(0.76, 0.62, 0.36)
buttons_per_row = 3
av_inputs = 1

[node name="Case" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh_case")
surface_material_override/0 = SubResource("Mat_case")

[node name="ScreenSeat" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.07, 0.14, 0.181)

