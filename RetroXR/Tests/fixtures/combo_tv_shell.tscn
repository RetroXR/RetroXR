transform = Transform3D(1, 0, 0, 0, -1, 0, 0, 0, -1, -0.07, 0.14, 0.192)

[node name="ButtonRow" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.16, 0.27, 0.185)

[node name="PortSeat" type="Marker3D" parent="."]
