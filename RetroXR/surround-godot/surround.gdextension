[configuration]

entry_symbol = "surround_library_init"
compatibility_minimum = "4.4.1"
reloadable = true

[libraries]

windows.debug.x86_64 = "surround_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "surround_godot.dll"
android.debug.arm64 = "libsurround_godot.android.template_debug.arm64.so"
android.release.arm64 = "libsurround_godot.android.template_release.arm64.so"
linux.debug.x86_64 = "libsurround_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "libsurround_godot.so"
linux.debug.arm64 = "libsurround_godot.linux.template_debug.arm64.so"
linux.release.arm64 = "libsurround_godot.so"
macos.debug.universal = "libsurround_godot.macos.template_debug.universal.dylib"
macos.release.universal = "libsurround_godot.dylib"
macos.debug.arm64 = "libsurround_godot.macos.template_debug.arm64.dylib"
macos.release.arm64 = "libsurround_godot.dylib"
macos.debug.x86_64 = "libsurround_godot.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "libsurround_godot.dylib"
