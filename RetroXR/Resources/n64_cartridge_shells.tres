[resource]
script = ExtResource("1")
source = "Colour options Nintendo offered N64 publishers, per micro-64 (http://micro-64.com/database/colouredcarts.shtml). The source gives names, not calibrated colours: every value here is a VISUAL APPROXIMATION. Released colours were sampled from micro-64's cartridge photographs, white-balanced against the backdrop; OFFERED_ONLY colours were never used commercially and have no photograph, so they are estimates. Edit freely."
presets = Array[ExtResource("2")]([SubResource("grey"), SubResource("black"), SubResource("blue"), SubResource("red"), SubResource("green"), SubResource("yellow"), SubResource("gold"), SubResource("silver"), SubResource("gold_silver"), SubResource("emerald_green"), SubResource("pink"), SubResource("beige"), SubResource("dark_grey"), SubResource("medium_grey")])
