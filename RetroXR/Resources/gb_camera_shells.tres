display_name = "Clear Purple (Pocket Camera)"
color = Color(0.74, 0.66, 0.9, 1)
roughness = 0.15
opacity = 0.75
frost = 0.45

[resource]
script = ExtResource("1")
source = "Game Boy Camera colors (GbCameraShell.PALETTE): the back half and the \"Nintendo\" half of the ball are in the color, the front half and the eye half stay charcoal (GbCameraShell.FRONT), as on every retail unit; a clear edition is clear on both. The colors are those of the model (RetroXR-models nintendo/gb/camera, colors.json and research/editions.md): red sampled from the user's unit, blue from Ashley Pomeroy's photographs (Wikimedia Commons), gold a pale champagne metal flake plastic (its sheen in flash photographs: the flat shell 199, 168, 131 to 216, 185, 150; the base here is darker and the flakes bright, as the Pokemon Gold cartridge's); yellow and green are of low confidence. The plain ROM is blue as it comes; the gold ROM (title GAMEBOYCAMERA G) is gold."
presets = Array[ExtResource("2")]([SubResource("camera_blue"), SubResource("camera_red"), SubResource("camera_yellow"), SubResource("camera_green"), SubResource("camera_gold"), SubResource("camera_clear_purple")])
