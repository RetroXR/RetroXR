[resource]
script = ExtResource("1")
source = "Game Boy Advance cartridge shells. Grey is the model's own plastic, solid. The Pokemon shells are dyed translucent plastic; opacity is how much of the board inside they hide. Every colour and opacity is a VISUAL APPROXIMATION, not a calibrated measurement. The shells keep the model's baked roughness, so roughness here is unused. GbaCartShell picks one per ROM. Edit freely."
presets = Array[ExtResource("2")]([SubResource("grey"), SubResource("ruby"), SubResource("sapphire"), SubResource("emerald"), SubResource("fire_red"), SubResource("leaf_green")])
