roughness = 0.6

[resource]
script = ExtResource("1")
source = "Game Boy Advance cartridge shells. Grey is the model's own plastic, solid. The Pokemon shells are dyed clear plastic; opacity is how strongly the dye filters and scatters (FireRed and LeafGreen are frosted, so higher). Colours were FITTED: each preset rendered lying on white under flat light until the per-channel median shell colour, the board showing through, matched a photo of the real cartridge (Ruby measured from a scan, the others read off photos). Change one by eye and it will drift from its photo. Roughness is the clear shells' gloss; grey keeps the model's baked roughness map. NES grey is solid and is the room's own NES cartridge plastic (nes_cart.glb NES_Shell_Plastic, linear 0.2685 = sRGB 0.555), so a Classic NES Series cartridge and an NES cartridge are the same grey. GbaCartShell picks one per ROM. Edit freely."
presets = Array[ExtResource("2")]([SubResource("grey"), SubResource("ruby"), SubResource("sapphire"), SubResource("emerald"), SubResource("fire_red"), SubResource("leaf_green"), SubResource("nes_grey")])
