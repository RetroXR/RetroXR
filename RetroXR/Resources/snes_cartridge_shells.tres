[resource]
script = ExtResource("1")
source = "Super NES cartridge shells. Grey is the model's own plastic. Black (Killer Instinct) and red (the North American Doom and Maximum Carnage) are VISUAL APPROXIMATIONS of their moulded colours, not a calibrated measurement. SnesCartShell picks one per ROM. Edit freely."
presets = Array[ExtResource("2")]([SubResource("grey"), SubResource("black"), SubResource("red")])
