[gd_resource type="Resource" script_class="CartridgeShellPalette" format=3]

[ext_resource type="Script" path="res://Scripts/Data/cartridge_shell_palette.gd" id="1"]
[ext_resource type="Script" path="res://Scripts/Data/cartridge_shell_preset.gd" id="2"]

[sub_resource type="Resource" id="smoke"]
script = ExtResource("2")
id = &"smoke"
display_name = "Clear smoke (standard)"
availability = 0
color = Color(0.496, 0.52, 0.53, 1)
roughness = 0.15
opacity = 0.75
frost = 0.45

[sub_resource type="Resource" id="crystal"]
script = ExtResource("2")
id = &"crystal"
display_name = "Clear blue glitter (Pokemon Crystal)"
finish = 1
color = Color(0.636, 0.763, 0.844, 1)
roughness = 0.3
opacity = 0.9
frost = 0.45
flake_color = Color(0.93, 0.94, 0.97, 1)
flake_density = 0.3
flake_size_mm = 0.25
flake_intensity = 0.8
flake_roughness = 0.2
flake_tilt = 0.4

[resource]
script = ExtResource("1")
source = "Game Boy Color-only cartridge shells, the clear CGB-002 moulding. Both are clear: smoke is the standard, and Pokemon Crystal's is clear blue with metal glitter in it (a METAL_FLAKE finish below opacity 1). Opacity is how strongly the dye filters and scatters, frost how far it blurs the board inside. Colours were FITTED: each preset rendered lying on white under flat light until the per-channel median shell colour, the board showing through, matched a photo of the real cartridge (smoke from the photographed specimen, Crystal from ScreenScraper's CGB-BYTE-USA photo). Change one by eye and it will drift from its photo. GbcCartShell picks one per ROM. Edit freely."
presets = Array[ExtResource("2")]([SubResource("smoke"), SubResource("crystal")])
