[configuration]

entry_symbol = "libretro_godot_library_init"
compatibility_minimum = "4.4.1"
reloadable = true

[libraries]

windows.debug.x86_64 = "libretro_godot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "libretro_godot.windows.template_release.x86_64.dll"
android.debug.arm64 = "liblibretro_godot.android.template_debug.arm64.so"
android.release.arm64 = "liblibretro_godot.android.template_release.arm64.so"
linux.debug.x86_64 = "libretro_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "libretro_godot.linux.template_release.x86_64.so"
linux.debug.arm64 = "libretro_godot.linux.template_debug.arm64.so"
linux.release.arm64 = "libretro_godot.linux.template_release.arm64.so"
macos.debug.universal = "libretro_godot.macos.template_debug.universal.dylib"
macos.release.universal = "libretro_godot.macos.template_release.universal.dylib"
macos.debug.arm64 = "libretro_godot.macos.template_debug.arm64.dylib"
macos.release.arm64 = "libretro_godot.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "libretro_godot.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "libretro_godot.macos.template_release.x86_64.dylib"

[dependencies]

windows.debug.x86_64 = {"SDL3.dll": ""}
windows.release.x86_64 = {"SDL3.dll": ""}
# SDL3 is linked by soname with no rpath, and it is new enough that many
# distros package it nowhere at all - so the export bundles a copy next to
# the executable, where the extension's $ORIGIN RUNPATH finds it. The x86_64
# file is the committed vendored one; CI overwrites both with fresh builds
# (the vendored x86_64 lib wants GLIBC_2.43).
linux.debug.x86_64 = {"external/SDL3/lib/linux-x64/libSDL3.so.0": ""}
linux.release.x86_64 = {"external/SDL3/lib/linux-x64/libSDL3.so.0": ""}
linux.debug.arm64 = {"external/SDL3/lib/linux-arm64/libSDL3.so.0": ""}
linux.release.arm64 = {"external/SDL3/lib/linux-arm64/libSDL3.so.0": ""}
