# type: ignore
#
# Standalone GDExtension: paper_godot (PaperSheetSolver: the Game Boy Printer's
# thermal paper, on the printer, in a hand and loose; GbThermalRibbon is its
# GDScript face). Built like verlet-rope: its own SCons invocation, reusing the
# godot-cpp checked out under libretro-godot.
#
#   scons platform=windows arch=x86_64 target=template_debug
#   scons platform=android arch=arm64  target=template_debug ANDROID_HOME=
#
# Or, for every extension at once: python Tools/build.py <platform>

VariantDir('Temp', '.', duplicate=0)
env = Environment()

import os
output_dir = os.environ.get('PAPER_GODOT_OUTPUT_DIR', '#../RetroXR/paper-godot')

SConscript('Temp/SConscript', exports=['env', 'output_dir'])
