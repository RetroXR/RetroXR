# type: ignore
#
# Standalone GDExtension: paper_godot (PaperStripSolver, PaperRibbonSolver: the
# Game Boy Printer's thermal paper, on the printer and torn off in the hand).
#
# The solvers were GDScript (GbPrinterStrip, GbThermalRibbon) and still are: the
# scripts keep their API and stay the reference, and hand their step() here when
# this library is loaded. Built like verlet-rope: its own SCons invocation,
# reusing the godot-cpp checked out under libretro-godot.
#
#   scons platform=windows arch=x86_64 target=template_debug
#   scons platform=android arch=arm64  target=template_debug ANDROID_HOME=
#
# Or, for every extension at once: python Tools/build.py <platform>

VariantDir('Temp', '.', duplicate=0)
env = Environment()

import os
output_dir = os.environ.get('PAPER_GODOT_OUTPUT_DIR', '#../RetroXR/paper-godot')

SConscript('Temp/SConscript', exports=['env', 'output_dir'])
